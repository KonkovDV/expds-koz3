+    reg = _reg(tmp_path, {"or": [str(tmp_path / "o.tif")]})
+    _Model.calls = 0
+    A.region_feats(reg, cfg, None, {}, tmp_path, crs_for=lambda r: UTM, phase_left=lambda: budget - clock.t,
