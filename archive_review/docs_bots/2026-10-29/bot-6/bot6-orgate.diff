+    assert info["removed_idx"] == fx["expected_removed_idx"] and len(info["removed_idx"]) >= 1
+    assert len(rest) == 0 and len(kept) == 43 - len(info["removed_idx"])
+    assert all("conf_stack" in k for k in kept)
