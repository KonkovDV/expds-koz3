+"""Scenario (a) of BUDGET §7: the EhimenNathan LiDAR heatmap expert, ported for our inference.
+
+Provenance: EhimenNathan-EXpedition @d434e56 (2026-10-27), read-only copy in koz3_shared/competitors/.
+  dtm.py, relief.py, hm.py — verbatim copies of koz3/{dtm,relief,hm}.py;
+  decode.py — the decoding part of koz3/li_train.py;
+  expert.py — inference/koz3_infer/experts/las.py:predict without the platform glue (models, crs and the
+  deadline are passed in; weights are not part of this repository).
+The upstream repository has no LICENSE file; the code is used under the competition's terms (THIRD_PARTY.md there).
+Speed changes on top of the verbatim port are listed in expert.py and BUDGET.md §7.12 (bot-8).
+"""
diff --git a/expds/li_a/decode.py b/expds/li_a/decode.py
new file mode 100644
index 0000000..6576362
--- /dev/null
+++ b/expds/li_a/decode.py
@@ -0,0 +1,103 @@
+"""Decoding of the LiDAR heatmaps (verbatim from EhimenNathan koz3/li_train.py @d434e56: lines 31-32, 294-383).
+
+Only the inference part is taken: the training module pulls in dataset paths (koz3.labels) at import time.
+"""
+import os
+
+import numpy as np
+
+from . import hm
+
+CLS = ["kurgany_povrezhdennye", "kurgany_tselye", "gorodishcha", "fortifikatsii"]
+N_HM, N_MK = 3, 4
+
+
+def neighbour_prior(peaks, R=200.0, K=3, snb=0.2, res=0.5):
+    """Kurgans come in cemeteries: kurgan-peak height × (0.5 + 0.5·clip(n/K, 0, 2)), n = other kurgan peaks of height
+    ≥ snb within R metres (nested OOF on the deployed blend 0.5765 → 0.5831, chosen in all folds)."""
+    from scipy.spatial import cKDTree
+    strong = np.array([(x, y) for c, x, y, s in peaks if c == 0 and s >= snb]).reshape(-1, 2)
+    t = cKDTree(strong) if len(strong) else None; out = []
+    for c, x, y, s in peaks:
+        if c == 0:
+            n = (len(t.query_ball_point((x, y), R / res)) - (1 if s >= snb else 0)) if t is not None else 0
+            s = s * (0.5 + 0.5 * float(np.clip(n / K, 0, 2)))
+        out.append((c, x, y, float(s)))
+    return out
+
+
+def decode_site(prob, valid, meta, thr=(0.1, 0.1, 0.1), dual=0.35, r_out=1.0, nms=11, prior=None):
+    """prob (7,H,W) → features in EPSG:3857 (small circles at peaks; the metric scores detection, not contour)."""
+    from pyproj import Transformer
+    from shapely.geometry import Point
+    tr = Transformer.from_crs(meta["crs"], 3857, always_xy=True)
+    feats = []
+    if prior:
+        peaks = neighbour_prior(hm.decode(prob[:N_HM], valid, thr=min(min(thr), 0.05), nms=nms), res=meta["res"], **prior)
+    else:
+        peaks = hm.decode(prob[:N_HM], valid, thr=min(thr), nms=nms)
+    mk = prob[N_HM:]
+    for ch, x, y, s in peaks:
+        if s < thr[ch]:
+            continue
+        yi, xi = int(y), int(x)
+        y0, y1, x0, x1 = max(0, yi - 2), yi + 3, max(0, xi - 2), xi + 3
+        if ch == 0:
+            pd, pi = float(mk[0, y0:y1, x0:x1].mean()), float(mk[1, y0:y1, x0:x1].mean())
+            tot = pd + pi + 1e-6
+            cand = [(0, pd / tot), (1, pi / tot)]
+            best = max(cand, key=lambda c: c[1])
+            emit = [best] + [c for c in cand if c is not best and c[1] >= dual]
+        else:
+            emit = [(ch + 1, 1.0)]
+        X, Y = meta["x0"] + x * meta["res"], meta["ytop"] - y * meta["res"]
+        mx, my = tr.transform(X, Y)
+        k = 1 / np.cos(np.radians(np.degrees(2 * np.arctan(np.exp(my / 6378137.0)) - np.pi / 2)))
+        for c, pc in emit:
+            feats.append({"type": "Feature", "geometry": Point(mx, my).buffer(r_out * k, 12).__geo_interface__,
+                          "properties": {"class_name": CLS[c], "confidence": float(s * pc), "region_name": meta.get("region", ""),
+                                         "markup_type": "li"}})
+    return feats
+
+
+def comp_feats(prob_mask, valid, meta, cls, thr, min_px, r_out=1.0):
+    import cv2
+    from pyproj import Transformer
+    from shapely.geometry import Polygon, Point
+    m = ((prob_mask > thr) & valid).astype(np.uint8)
+    n, lab, st, _ = cv2.connectedComponentsWithStats(m, connectivity=8)
+    tr = Transformer.from_crs(meta["crs"], 3857, always_xy=True); out = []
+    for k in range(1, n):
+        if st[k, cv2.CC_STAT_AREA] < min_px:
+            continue
+        cs, _ = cv2.findContours((lab == k).astype(np.uint8), cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_NONE)
+        c = max(cs, key=cv2.contourArea)
+        if len(c) < 4:
+            continue
+        p = Polygon(c[:, 0, :] + 0.5).buffer(0)
+        if p.is_empty:
+            continue
+        p = max(p.geoms, key=lambda g: g.area) if p.geom_type != "Polygon" else p
+        mode = os.environ.get("LI_ANCHOR", "rep")       # rep: surface point; pole: pole of inaccessibility; peak: prob max
+        if mode == "pole":
+            from shapely.ops import polylabel
+            rp = polylabel(p, tolerance=0.5)
+        elif mode == "peak":
+            yy, xx = np.where(lab == k); j = int(np.argmax(prob_mask[yy, xx])); rp = Point(xx[j] + 0.5, yy[j] + 0.5)
+        else:
+            rp = p.representative_point()
+        mx, my = tr.transform(meta["x0"] + rp.x * meta["res"], meta["ytop"] - rp.y * meta["res"])
+        kk = 1 / np.cos(np.radians(np.degrees(2 * np.arctan(np.exp(my / 6378137.0)) - np.pi / 2)))
+        out.append({"type": "Feature", "geometry": Point(mx, my).buffer(r_out * kk, 12).__geo_interface__,
+                    "properties": {"class_name": cls, "confidence": float(prob_mask[lab == k].mean()), "region_name": meta["region"], "markup_type": "li"}})
+    return out
+
+
+def decode_site_v2(prob, valid, meta, thr=0.1, dual=0.3, comp_thr=0.5, fort_min_px=30, gor_min_px=600, r_out=1.0, prior=None):
+    """Deployed LiDAR decoding (nested OOF 0.5223): kurgans from heatmap peaks (damaged/intact from the masks, dual
+    emission), hillforts and fortifications from mask components (representative point of each component)."""
+    feats = [f for f in decode_site(prob, valid, meta, thr=(thr, thr, thr), dual=dual, r_out=r_out, prior=prior)
+             if f["properties"]["class_name"] not in ("fortifikatsii", "gorodishcha")]
+    feats += comp_feats(prob[N_HM + CLS.index("fortifikatsii")], valid, meta, "fortifikatsii", comp_thr, fort_min_px, r_out)
+    feats += comp_feats(prob[N_HM + CLS.index("gorodishcha")], valid, meta, "gorodishcha", comp_thr, gor_min_px, r_out)
+    return feats
diff --git a/expds/li_a/dtm.py b/expds/li_a/dtm.py
new file mode 100644
index 0000000..efbf9b8
--- /dev/null
+++ b/expds/li_a/dtm.py
@@ -0,0 +1,124 @@
+"""LAS → DTM (shared by training prep and inference).
+
+Ground = class 2 when it makes up ≥ 5 % of points; otherwise per-cell minimum + progressive morphological filter.
+Points are streamed in chunks, so multi-GB clouds fit in memory. Cells without ground are filled from the nearest
+ground cell and marked invalid if farther than FILL_M.
+"""
+import numpy as np
+from scipy import ndimage as ndi
+
+RES = 0.25
+FILL_M = 3.0
+MAX_CELLS = 250_000_000
+
+
+def _bounds(path):
+    import laspy
+    with laspy.open(path) as r:
+        h = r.header
+        return h.mins, h.maxs, h.point_count
+
+
+def ground_fraction(path, sample=2_000_000):
+    import laspy
+    with laspy.open(path) as r:
+        for pts in r.chunk_iterator(sample):
+            c = np.asarray(pts.classification)
+            return float((c == 2).mean())
+    return 0.0
+
+
+def is_ground_only(path, sample=2_000_000, cell=1.0, max_spread=0.6):
+    """True when the cloud is already ground-only (e.g. training site 101: all class 8). Within 1 m cells the vertical
+    spread of a bare-earth cloud is small; vegetation / buildings give metres. PMF on such clouds shaves mounds."""
+    import laspy
+    with laspy.open(path) as r:
+        for pts in r.chunk_iterator(sample):
+            x, y, z = np.asarray(pts.x), np.asarray(pts.y), np.asarray(pts.z)
+            k = ((x - x.min()) // cell).astype(np.int64) * 1_000_003 + ((y - y.min()) // cell).astype(np.int64)
+            order = np.argsort(k); k, z = k[order], z[order]
+            starts = np.r_[0, np.nonzero(np.diff(k))[0] + 1]
+            zmax = np.maximum.reduceat(z, starts); zmin = np.minimum.reduceat(z, starts)
+            n = np.diff(np.r_[starts, len(k)])
+            spread = (zmax - zmin)[n >= 3]
+            return bool(spread.size) and float(np.percentile(spread, 95)) < max_spread
+    return False
+
+
+def build(path, res=RES):
+    """→ dtm float32 (H,W) (NaN-free), valid bool (H,W), (x0, y_top, res) grid origin in the LAS CRS."""
+    import laspy
+    mins, maxs, n = _bounds(path)
+    while ((maxs[0] - mins[0]) / res) * ((maxs[1] - mins[1]) / res) > MAX_CELLS:
+        res *= 2
+    x0, y1 = np.floor(mins[0]), np.ceil(maxs[1])
+    W = int(np.ceil((maxs[0] - x0) / res)) + 1
+    H = int(np.ceil((y1 - mins[1]) / res)) + 1
+    use_class = ground_fraction(path) >= 0.05
+    all_ground = (not use_class) and is_ground_only(path)
+    zsum = np.zeros(H * W, np.float64); cnt = np.zeros(H * W, np.int32)
+    zmin = np.full(H * W, np.inf, np.float32)
+    with laspy.open(path) as r:
+        for pts in r.chunk_iterator(5_000_000):
+            x, y, z = np.asarray(pts.x), np.asarray(pts.y), np.asarray(pts.z, np.float32)
+            if use_class:
+                m = np.asarray(pts.classification) == 2
+                x, y, z = x[m], y[m], z[m]
+            else:
+                m = np.isin(np.asarray(pts.classification), (7, 18), invert=True)   # drop flagged noise
+                x, y, z = x[m], y[m], z[m]
+            ix = ((x - x0) / res).astype(np.int64); iy = ((y1 - y) / res).astype(np.int64)
+            ok = (ix >= 0) & (ix < W) & (iy >= 0) & (iy < H)
+            k = iy[ok] * W + ix[ok]
+            if use_class or all_ground:
+                zsum += np.bincount(k, z[ok], minlength=H * W); cnt += np.bincount(k, minlength=H * W).astype(np.int32)
+            else:
+                np.minimum.at(zmin, k, z[ok])
+    if use_class or all_ground:
+        has = cnt > 0
+        g = np.where(has, zsum / np.maximum(cnt, 1), np.nan).astype(np.float32).reshape(H, W)
+    else:
+        g = np.where(np.isfinite(zmin), zmin, np.nan).reshape(H, W)
+        g = pmf(g, res)
+    has = np.isfinite(g)
+    dist, (iy_, ix_) = ndi.distance_transform_edt(~has, return_indices=True)
+    dtm = g[iy_, ix_]
+    filled = ~has
+    if filled.any():
+        sm = ndi.gaussian_filter(dtm, 1.0)
+        dtm = np.where(filled, sm, dtm)
+    valid = dist * res <= FILL_M
+    return dtm.astype(np.float32), valid, (float(x0), float(y1), float(res))
+
+
+def pmf(zmin, res, slope=0.3, dh0=0.3, dh_max=3.0, windows_m=(1, 2, 4, 8, 16)):
+    """Progressive morphological filter (Zhang et al. 2003) on a min-z grid; non-ground cells → NaN."""
+    g = zmin.copy()
+    fill = np.isnan(g)
+    if fill.all():
+        return g
+    _, (iy, ix) = ndi.distance_transform_edt(fill, return_indices=True)
+    surf = g[iy, ix]
+    ground = ~fill
+    prev = 0.0
+    for w in windows_m:
+        k = max(3, int(round(w / res)) | 1)
+        opened = ndi.grey_opening(surf, size=(k, k))
+        dh = min(dh_max, dh0 + slope * (w - prev)) if prev else dh0
+        ground &= (surf - opened) <= dh
+        surf = opened
+        prev = w
+    out = zmin.copy()
+    out[~ground] = np.nan
+    return out
+
+
+def save(path_out, dtm, valid, origin, crs):
+    zo = float(np.floor(dtm[valid].min())) if valid.any() else 0.0
+    q = np.clip(np.round((dtm - zo) * 100), 0, 65535).astype(np.uint16)
+    np.savez_compressed(path_out, dtm_cm=q, z0=zo, valid=valid, origin=np.array(origin), crs=str(crs))
+
+
+def load(path):
+    z = np.load(path)
+    return z["dtm_cm"].astype(np.float32) / 100 + float(z["z0"]), z["valid"], tuple(z["origin"]), str(z["crs"])
diff --git a/expds/li_a/expert.py b/expds/li_a/expert.py
new file mode 100644
index 0000000..c1e6b47
--- /dev/null
+++ b/expds/li_a/expert.py
@@ -0,0 +1,70 @@
+"""LiDAR expert (scenario (a)): LAS → DTM → relief channels → U-Net ensemble → peaks.
+
+Port of EhimenNathan inference/koz3_infer/experts/las.py:predict (@d434e56). The platform glue (weights loading,
+UTM.json lookup, logging) is passed in: models = [(model, kind, weight)], kind '' (9 ch), 'x' (12 ch) or 'u'.
+"""
+import time
+
+import numpy as np
+
+from . import dtm, hm, relief
+from .decode import N_HM, N_MK, decode_site_v2
+
+
+def oom_retry(fn, tiles=(1024, 512, 256), log=print):
+    """Run fn(tile) and retry with smaller tiles on CUDA out-of-memory (verbatim, koz3_infer/common.py:154)."""
+    import torch
+    for i, t in enumerate(tiles):
+        try:
+            return fn(t)
+        except torch.OutOfMemoryError:
+            torch.cuda.empty_cache()
+            log(f"CUDA OOM at tile {t}" + (f", retrying at {tiles[i + 1]}" if i + 1 < len(tiles) else ", giving up"))
+            if i + 1 == len(tiles):
+                raise
+
+
+def _channels_extra(d, v, res, unclip=False, dev="cuda"):
+    """12-channel relief exactly as in training (koz3.relief with EXTRA on; UNCLIP for li_u_ models), then restored."""
+    e0, n0, u0 = relief.EXTRA, relief.N_CH, getattr(relief, "UNCLIP", False)
+    relief.EXTRA, relief.N_CH, relief.UNCLIP = True, 12, unclip
+    try:
+        return relief.channels_tiled(d, v, res, dev=dev)[0]
+    finally:
+        relief.EXTRA, relief.N_CH, relief.UNCLIP = e0, n0, u0
+
+
+def site_probs(d, v, res, models, c, deadline, dev="cuda", log=print):
+    """DTM → blended probability maps (N_HM + N_MK, h, w) and the valid mask at relief.NET_RES."""
+    x, vv = relief.channels_tiled(d, v, res, dev=dev)
+    if time.time() > deadline - 120:
+        models = models[:1]      # protect the time budget on huge clouds
+    xs = {"": x}
+    if any(k == "x" for _, k, _ in models):
+        xs["x"] = _channels_extra(d, v, res, dev=dev)
+    if any(k == "u" for _, k, _ in models):
+        xs["u"] = _channels_extra(d, v, res, unclip=True, dev=dev)
+    tta = c.get("tta", True)        # "d8": 4 rotations × 2 flips (nested OOF 0.5651 → 0.5695); True: 3 flips
+    if tta == "d8" and time.time() > deadline - 300:
+        tta = True                     # protect the time budget
+    ps = [oom_retry(lambda t, m=m, xx=xs[k]: hm.predict_tiled(m, xx, N_HM + N_MK, tile=t, overlap=min(192, t // 4), tta=tta, dev=dev), log=log)
+          for m, k, _ in models]
+    ws = np.array([w for _, _, w in models], np.float32)
+    prob = np.tensordot(ws / ws.sum(), np.stack(ps), axes=1)
+    return prob, vv
+
+
+def predict(paths, models, c, crs, region_name, deadline, dev="cuda", log=print):
+    """→ GeoJSON-like features (EPSG:3857) for the LAS files of one region; c = config['li']."""
+    feats = []
+    for p in paths:
+        t0 = time.time()
+        d, v, (x0, ytop, res) = dtm.build(str(p))
+        prob, vv = site_probs(d, v, res, models, c, deadline, dev=dev, log=log)
+        meta = {"x0": x0, "ytop": ytop, "res": relief.NET_RES, "crs": crs, "region": region_name}
+        fs = decode_site_v2(prob, vv, meta, thr=c["thr"], dual=c["dual"], comp_thr=c["comp_thr"], fort_min_px=c["fort_min_px"], gor_min_px=c["gor_min_px"], r_out=c["r_out"], prior=c.get("nbr_prior"))
+        for f in fs:
+            f["properties"].update({"sub_region_name": "", "crs": "urn:ogc:def:crs:EPSG::3857"})
+        feats += fs
+        log(f"li {p.name if hasattr(p, 'name') else p}: dtm {d.shape} res {res} → {len(fs)} feats {time.time() - t0:.0f}s")
+    return feats
diff --git a/expds/li_a/hm.py b/expds/li_a/hm.py
new file mode 100644
index 0000000..eacb3bc
--- /dev/null
+++ b/expds/li_a/hm.py
@@ -0,0 +1,121 @@
+"""Generic CenterNet-style heads shared by the LiDAR / optical experts.
+
+Targets per class: Gaussian peak at each object's representative point (the point the metric tests) with
+sigma ∝ object size, plus the object mask. Decoding: max-pool NMS peaks → score = peak height.
+"""
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+
+def draw_targets(shape, objects, n_cls, sig_frac=0.12, sig_min=1.5, sig_max=40.0):
+    """objects: list of (cls, polygon in pixel coords). → hm (n_cls,H,W) float32, mask (n_cls,H,W) uint8."""
+    from rasterio.features import rasterize
+    H, W = shape
+    hm = np.zeros((n_cls, H, W), np.float32)
+    mk = np.zeros((n_cls, H, W), np.uint8)
+    by_cls = {}
+    for c, g in objects:
+        by_cls.setdefault(c, []).append(g)
+        p = g.representative_point()
+        size = np.sqrt(max(g.area, 1.0))
+        s = float(np.clip(sig_frac * size, sig_min, sig_max))
+        r = int(3 * s)
+        cx, cy = int(round(p.x)), int(round(p.y))
+        x0, x1, y0, y1 = max(0, cx - r), min(W, cx + r + 1), max(0, cy - r), min(H, cy + r + 1)
+        if x0 >= x1 or y0 >= y1:
+            continue
+        yy, xx = np.mgrid[y0:y1, x0:x1]
+        gk = np.exp(-((xx - cx) ** 2 + (yy - cy) ** 2) / (2 * s * s)).astype(np.float32)
+        hm[c, y0:y1, x0:x1] = np.maximum(hm[c, y0:y1, x0:x1], gk)
+        if 0 <= cy < H and 0 <= cx < W:
+            hm[c, cy, cx] = 1.0
+    for c, gs in by_cls.items():
+        mk[c] = rasterize([(g, 1) for g in gs if not g.is_empty], out_shape=(H, W), dtype=np.uint8, all_touched=True)
+    return hm, mk
+
+
+def focal_hm(logit, hm, w):
+    """CenterNet focal loss; w broadcastable weight mask (valid area)."""
+    p = torch.sigmoid(logit.float()).clamp(1e-4, 1 - 1e-4)
+    pos = hm.ge(0.999).float()
+    pl = -torch.log(p) * (1 - p) ** 2 * pos
+    nl = -torch.log(1 - p) * p ** 2 * (1 - hm) ** 4 * (1 - pos)
+    return ((pl + nl) * w).sum() / (pos * w).sum().clamp(min=1)
+
+
+def bce_dice(logit, t, w):
+    logit = logit.float()
+    bce = (F.binary_cross_entropy_with_logits(logit, t, reduction="none") * w).sum() / w.expand_as(t).sum().clamp(min=1)
+    p = torch.sigmoid(logit) * w
+    dice = 1 - (2 * (p * t).sum((0, 2, 3)) + 1) / (p.sum((0, 2, 3)) + (t * w).sum((0, 2, 3)) + 1)
+    return bce + dice.mean()
+
+
+def bce_softf1(logit, t, w, cls_w=(30.0, 20.0, 15.0, 5.0)):
+    """Metric-shaped mask loss: BCE + 1 − weighted soft-F1 with the metric's 0.5·FP cost, per class weight."""
+    logit = logit.float()
+    bce = (F.binary_cross_entropy_with_logits(logit, t, reduction="none") * w).sum() / w.expand_as(t).sum().clamp(min=1)
+    p = torch.sigmoid(logit) * w; tw = t * w
+    tp = (p * tw).sum((0, 2, 3)); fp = (p * (1 - t) * w).sum((0, 2, 3)); fn = ((1 - p) * tw).sum((0, 2, 3))
+    cw = torch.tensor(cls_w[:logit.shape[1]], device=logit.device, dtype=tp.dtype)
+    f1 = (2 * (cw * tp).sum() + 1) / (2 * (cw * tp).sum() + (cw * fn).sum() + 0.5 * (cw * fp).sum() + 1)
+    return bce + (1 - f1)
+
+
+def decode(hm, valid=None, thr=0.05, nms=9):
+    """hm (C,H,W) numpy → list of (cls, x, y, score)."""
+    t = torch.from_numpy(np.ascontiguousarray(hm))[None]
+    mx = F.max_pool2d(t, nms, 1, nms // 2)
+    keep = ((t == mx) & (t > thr))[0].numpy()
+    if valid is not None:
+        keep &= valid[None]
+    out = []
+    for c, y, x in zip(*np.nonzero(keep)):
+        out.append((int(c), float(x) + 0.5, float(y) + 0.5, float(hm[c, y, x])))
+    return out
+
+
+@torch.no_grad()
+def predict_tiled(model, img, n_out, tile=1024, overlap=192, tta=True, dev="cuda"):
+    """img (C,H,W) float32 numpy → (n_out,H,W) sigmoid maps, tiled with flip TTA and linear blending."""
+    C, H, W = img.shape
+    out = np.zeros((n_out, H, W), np.float32); cnt = np.zeros((H, W), np.float32)
+    step = tile - overlap
+    ramp = np.minimum(np.arange(tile) + 1, overlap) / overlap
+    for y in list(range(0, max(1, H - overlap), step)):
+        for x in list(range(0, max(1, W - overlap), step)):
+            y1, x1 = min(H, y + tile), min(W, x + tile)
+            t = img[:, y:y1, x:x1]
+            h, w = t.shape[1:]
+            ph, pw = (-h) % 32, (-w) % 32
+            tt = torch.from_numpy(np.pad(t, ((0, 0), (0, ph), (0, pw)), mode="reflect" if min(h, w) > max(ph, pw) else "constant")).float()[None].to(dev)
+            acc = 0
+            if tta == "d8" and tt.shape[-1] == tt.shape[-2]:        # 4 rotations × 2 flips on full square tiles only
+                # (padding small sites to a square and rotating them gave no gain: OOF 0.5651 vs 0.5695)
+                views = [(k, fl) for k in range(4) for fl in (False, True)]
+            else:
+                views = [(0, ()), (0, (-1,)), (0, (-2,))] if tta else [(0, ())]
+            for k, fl in views:
+                z = torch.rot90(tt, k, dims=(-2, -1)) if k else tt
+                if fl is True:
+                    z = z.flip(-1)
+                elif fl:
+                    z = z.flip(fl)
+                with torch.autocast("cuda", dtype=torch.bfloat16):
+                    o = torch.sigmoid(model(z).float())
+                if fl is True:
+                    o = o.flip(-1)
+                elif fl:
+                    o = o.flip(fl)
+                acc = acc + (torch.rot90(o, -k, dims=(-2, -1)) if k else o)
+            o = (acc / len(views))[0, :, :h, :w].cpu().numpy()
+            wy = np.minimum(ramp[:h], ramp[:h][::-1]) if (y > 0 or y1 < H) else np.ones(h)
+            wx = np.minimum(ramp[:w], ramp[:w][::-1]) if (x > 0 or x1 < W) else np.ones(w)
+            if y == 0: wy[:overlap] = 1
+            if y1 == H: wy[-overlap:] = 1
+            if x == 0: wx[:overlap] = 1
+            if x1 == W: wx[-overlap:] = 1
+            wgt = np.outer(wy, wx).astype(np.float32)
+            out[:, y:y1, x:x1] += o * wgt; cnt[y:y1, x:x1] += wgt
+    return out / np.maximum(cnt, 1e-6)
