+def _etgr_layer_on() -> bool:
+    """bot-10, task C: EXPDS_ETGR_LAYER=1 — EtGr object_poly сопоставляются только в пределах своего слоя
+    (карта глубин / профиль = отдельный эталон, RULES_ORG_2026-10-29_misc.md п.4). По умолчанию выкл."""
+    import os
+    return os.environ.get("EXPDS_ETGR_LAYER", "0") in ("1", "on", "true")
+
+
+def _etgr_layer_key(props: dict):
+    """None — не EtGr; иначе frozenset ключей слоя ('Гнёздово_Усадьба_EtGr_профиль_14')."""
+    import re
+    if str(props.get("markup_type", "")) != "etgr":
+        return None
+    lay = props.get("etgr_layers")
+    if lay:
+        return frozenset(str(lay).split("|"))
+    src = str(props.get("source", "") or "")
+    if not src:
+        return frozenset(["?"])
+    src = re.sub(r"\.(tif|tiff|geojson)$", "", src.split("/")[-1], flags=re.I)
+    src = re.sub(r"_ObjectPoly$", "", src)
+    src = re.sub(r"^\d+_", "", src)
+    return frozenset([src])
+
