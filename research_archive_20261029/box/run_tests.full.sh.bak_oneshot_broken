#!/usr/bin/env bash
# CPU test runner for KonkovDV/expds-koz3 on box «1».
# Usage:
#   /home/box/shared/koz3/box/run_tests.sh <branch-or-ref>
#   /home/box/shared/koz3/box/run_tests.sh --cleanup <branch-or-ref>
#   /home/box/shared/koz3/box/run_tests.sh --cleanup-all
#
# Does NOT push, does NOT modify main. Safe to re-run: worktree is reused/reset.
#
# Robustness (2026-10-29 triage):
# - only passes existing test dirs to pytest (tests/, centerhead/tests)
# - consistent selection across branches (never bare pytest with hardcoded missing paths)
# - env plugin skips missing weights / optional deps / CUDA rather than counting as fail
# - worktree lock retries; single-flight advisory lock against concurrent runners
# - -rfEs so FAILED lines appear in short summary; counts taken from last summary per run
set -euo pipefail

REPO="${KOZ3_REPO:-/workspace/koz3-repo}"
VENV="${KOZ3_VENV:-/workspace/koz3-venv}"
WT_ROOT="${KOZ3_WT_ROOT:-/workspace/koz3-wt}"
RESULTS="${KOZ3_RESULTS:-/home/box/shared/koz3/box/results}"
SHARED_BOX="/home/box/shared/koz3/box"
PLUGIN_DIR="${KOZ3_PLUGIN_DIR:-$SHARED_BOX/plugins}"
LOCK_FILE="${KOZ3_LOCK:-$SHARED_BOX/results/.run_tests.lock}"

sanitize() {
  echo "$1" | sed -E 's#[/\\ ]+#-#g; s#[^A-Za-z0-9._+-]#_#g; s#-+#-#g'
}

ensure_layout() {
  mkdir -p "$WT_ROOT" "$RESULTS" "$PLUGIN_DIR"
  chmod a+rwx "$SHARED_BOX" "$RESULTS" "$WT_ROOT" 2>/dev/null || true
  chmod a+rwX "$SHARED_BOX" "$RESULTS" 2>/dev/null || true
}

cleanup_one() {
  local ref="$1"
  local name
  name="$(sanitize "$ref")"
  local wt="$WT_ROOT/$name"
  if [[ -d "$wt" ]]; then
    git -C "$REPO" worktree remove --force "$wt" 2>/dev/null \
      || { rm -rf "$wt"; git -C "$REPO" worktree prune; }
    echo "removed worktree: $wt"
  else
    echo "no worktree at $wt"
  fi
  if git -C "$REPO" show-ref --verify --quiet "refs/heads/wt/$name"; then
    git -C "$REPO" branch -D "wt/$name" 2>/dev/null || true
  fi
}

cleanup_all() {
  ensure_layout
  local d
  for d in "$WT_ROOT"/*; do
    [[ -d "$d" ]] || continue
    git -C "$REPO" worktree remove --force "$d" 2>/dev/null || rm -rf "$d"
  done
  git -C "$REPO" worktree prune
  echo "all worktrees under $WT_ROOT cleaned"
}

if [[ "${1:-}" == "--cleanup-all" ]]; then
  cleanup_all
  exit 0
fi
if [[ "${1:-}" == "--cleanup" ]]; then
  [[ -n "${2:-}" ]] || { echo "usage: $0 --cleanup <branch>"; exit 2; }
  cleanup_one "$2"
  exit 0
fi

REF="${1:-}"
if [[ -z "$REF" ]]; then
  echo "usage: $0 <branch-or-ref>"
  echo "       $0 --cleanup <branch-or-ref>"
  echo "       $0 --cleanup-all"
  exit 2
fi

ensure_layout

if [[ ! -d "$REPO/.git" ]]; then
  echo "ERROR: repo not found at $REPO" >&2
  exit 1
fi
if [[ ! -x "$VENV/bin/python" ]]; then
  echo "ERROR: venv not found at $VENV" >&2
  exit 1
fi

# Prefer rustup toolchain if present (system rustc may be too old for expds_core).
# shellcheck disable=SC1090
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env" || true
export PATH="$VENV/bin:${HOME}/.cargo/bin:${PATH}"
export VIRTUAL_ENV="$VENV"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-2}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-2}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-2}"
export NUMEXPR_NUM_THREADS="${NUMEXPR_NUM_THREADS:-2}"
export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-2}"
# Env-skip plugin for missing weights / CUDA / optional deps
export PYTHONPATH="${PLUGIN_DIR}${PYTHONPATH:+:$PYTHONPATH}"

NAME="$(sanitize "$REF")"
WT="$WT_ROOT/$NAME"

# Single-flight: another pytest/run_tests would thrash RAM and race worktree locks.
acquire_lock() {
  local waited=0
  while true; do
    if ( set -o noclobber; echo "$$ $REF $(date -Iseconds)" > "$LOCK_FILE" ) 2>/dev/null; then
      trap 'rm -f "$LOCK_FILE"' EXIT
      return 0
    fi
    local holder
    holder="$(cat "$LOCK_FILE" 2>/dev/null || true)"
    local hpid="${holder%% *}"
    if [[ -n "$hpid" ]] && [[ "$hpid" =~ ^[0-9]+$ ]] && ! kill -0 "$hpid" 2>/dev/null; then
      rm -f "$LOCK_FILE"
      continue
    fi
    # Also respect any live run_tests / pytest from siblings that forgot the lock
    if ! pgrep -f 'run_tests\.(full\.)?sh ' >/dev/null && ! pgrep -f 'python -m pytest' >/dev/null; then
      rm -f "$LOCK_FILE"
      continue
    fi
    if (( waited >= 3600 )); then
      echo "ERROR: timed out waiting for run_tests lock (holder: $holder)" >&2
      exit 1
    fi
    echo "waiting for lock (holder: $holder) … ${waited}s"
    sleep 15
    waited=$((waited + 15))
  done
}
acquire_lock

echo "== fetch =="
git -C "$REPO" fetch --prune origin "+refs/heads/*:refs/remotes/origin/*" || \
  git -C "$REPO" fetch --prune origin

RESOLVED=""
if git -C "$REPO" rev-parse --verify --quiet "origin/$REF" >/dev/null; then
  RESOLVED="origin/$REF"
elif git -C "$REPO" rev-parse --verify --quiet "$REF" >/dev/null; then
  RESOLVED="$REF"
else
  echo "ERROR: cannot resolve ref '$REF'" >&2
  exit 1
fi
SHA="$(git -C "$REPO" rev-parse --short "$RESOLVED")"
FULL="$(git -C "$REPO" rev-parse "$RESOLVED")"
echo "ref=$REF resolved=$RESOLVED sha=$SHA"

echo "== worktree =="
# Retry on index.lock races (seen when parallel batch runners hit the same repo).
worktree_ready=0
for attempt in 1 2 3 4 5; do
  # Clear stale locks
  find "$REPO/.git" -name '*.lock' -type f 2>/dev/null | while read -r lk; do
    # Only remove if no live git process holds it — best-effort stale cleanup
    if ! pgrep -x git >/dev/null 2>&1; then
      rm -f "$lk"
    fi
  done
  # Also clear known stale worktree index.lock if older than 60s and no git running
  for lk in "$REPO/.git/worktrees"/*/index.lock "$REPO/.git/index.lock"; do
    [[ -f "$lk" ]] || continue
    age=$(( $(date +%s) - $(stat -c %Y "$lk" 2>/dev/null || echo 0) ))
    if (( age > 60 )) && ! pgrep -x git >/dev/null 2>&1; then
      echo "WARN: removing stale lock $lk (age ${age}s)"
      rm -f "$lk"
    fi
  done

  if [[ -d "$WT/.git" || -f "$WT/.git" ]]; then
    if git -C "$WT" fetch --quiet origin 2>/dev/null \
      && git -C "$WT" checkout --detach --force "$FULL" \
      && git -C "$WT" reset --hard "$FULL"; then
      git -C "$WT" clean -fdx -e target -e 'rust/**/target' 2>/dev/null || git -C "$WT" clean -fd || true
      worktree_ready=1
      break
    fi
  else
    [[ -d "$WT" ]] && rm -rf "$WT"
    if git -C "$REPO" worktree add --detach "$WT" "$FULL"; then
      worktree_ready=1
      break
    fi
  fi
  echo "WARN: worktree attempt $attempt failed; retry in 3s"
  sleep 3
done
if [[ "$worktree_ready" != 1 ]]; then
  echo "ERROR: could not prepare worktree at $WT for $FULL" >&2
  exit 128
fi
git -C "$WT" status -sb || true

REPORT="$RESULTS/${NAME}_${SHA}.md"
LOG="$RESULTS/${NAME}_${SHA}.log"
META="$RESULTS/${NAME}_${SHA}.meta"
rm -f "$LOG" "$META"
START_ISO="$(date '+%Y-%m-%d %H:%M:%S %Z')"
echo "== build rust (optional, best-effort) =="
(
  cd "$WT"
  if command -v maturin >/dev/null 2>&1 && command -v rustc >/dev/null 2>&1; then
    export RUSTFLAGS="${RUSTFLAGS:--C target-cpu=native}"
    maturin develop --release -m rust/expds_core/Cargo.toml \
      && "$VENV/bin/python" -c "import expds_core; print('expds_core', expds_core.version())" \
      || echo "WARN: expds_core build failed; tests will use NumPy fallbacks"
  else
    echo "WARN: maturin/rustc missing; skip Rust build"
  fi
) 2>&1 | tee -a "$LOG"

echo "== smoke import =="
(
  cd "$WT"
  "$VENV/bin/python" -m compileall -q expds scripts inference tests centerhead materials 2>/dev/null || true
  "$VENV/bin/python" -c "import expds.pipeline, expds.watchdog, expds.post, expds.metric; print('import ok')" \
    || echo "WARN: smoke import failed"
) 2>&1 | tee -a "$LOG"

echo "== pytest (existing dirs only, low RAM) =="
# Discover test paths present on THIS branch — never hardcode missing dirs.
TEST_PATHS=()
[[ -d "$WT/tests" ]] && TEST_PATHS+=("tests")
[[ -d "$WT/centerhead/tests" ]] && TEST_PATHS+=("centerhead/tests")
if [[ ${#TEST_PATHS[@]} -eq 0 ]]; then
  echo "ERROR: no tests/ or centerhead/tests in worktree $WT" >&2
  exit 1
fi
echo "test paths: ${TEST_PATHS[*]}"

set +e
"$VENV/bin/python" - "$WT" "$LOG" "$META" "${TEST_PATHS[@]}" <<'PY'
import os, sys, time, subprocess, threading, json
from pathlib import Path
try:
    import psutil
except ImportError:
    psutil = None

wt, log_path, meta_path = Path(sys.argv[1]), Path(sys.argv[2]), Path(sys.argv[3])
paths = sys.argv[4:]
# One pytest invocation with all existing paths → consistent counts, no double-run.
# -rfEs: failed+error+skipped in short summary (bare -rs replaces default fE and hides FAILED lines).
# -p koz3_box_env: skip missing weights / CUDA / optional deps on this box.
args = ["-q", "-rfEs", "-p", "no:cacheprovider", "-p", "koz3_box_env", *paths]
env = os.environ.copy()
peak = 0
t0 = time.perf_counter()
vpy = Path(os.environ.get("VIRTUAL_ENV", "/workspace/koz3-venv")) / "bin" / "python"
cmd = [str(vpy), "-m", "pytest", *args]
with log_path.open("a", encoding="utf-8") as log:
    header = f"\n### CMD: {' '.join(cmd)}\n### PATHS: {paths}\n"
    print(header, end="", flush=True)
    log.write(header); log.flush()
    proc = subprocess.Popen(
        cmd, cwd=str(wt), env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1
    )
    stop = False
    def monitor(p=proc):
        global peak
        if psutil is None:
            return
        try:
            pp = psutil.Process(p.pid)
        except Exception:
            return
        while not stop:
            try:
                rss = pp.memory_info().rss
                for c in pp.children(recursive=True):
                    try:
                        rss += c.memory_info().rss
                    except Exception:
                        pass
                if rss > peak:
                    peak = rss
            except Exception:
                pass
            time.sleep(0.25)
    th = threading.Thread(target=monitor, daemon=True)
    th.start()
    assert proc.stdout is not None
    for line in proc.stdout:
        sys.stdout.write(line); sys.stdout.flush()
        log.write(line)
    rc = proc.wait()
    stop = True
    th.join(timeout=2)
    footer = f"### EXIT {rc}\n"
    print(footer, end="", flush=True)
    log.write(footer); log.flush()

elapsed = time.perf_counter() - t0
meta_path.write_text(
    f"exit={rc}\nelapsed_s={elapsed:.1f}\npeak_rss_bytes={peak}\npeak_rss_mb={peak/1024/1024:.1f}\npaths={json.dumps(paths)}\n",
    encoding="utf-8",
)
print(f"=== META exit={rc} elapsed={elapsed:.1f}s peak_rss_mb={peak/1024/1024:.1f} paths={paths} ===", flush=True)
sys.exit(rc)
PY
TEST_RC=$?
set -e
END_ISO="$(date '+%Y-%m-%d %H:%M:%S %Z')"

# Parse the final summary line only (avoid double-counting from interleaved/concurrent logs).
parse_summary() {
  "$VENV/bin/python" - "$LOG" <<'PY3'
import re, sys
text = open(sys.argv[1], encoding="utf-8", errors="replace").read()
# last "N failed, M passed, ..." or "M passed, ..." line
pat = re.compile(
    r"^(?P<summary>(?:(?P<failed>\d+) failed, )?(?P<passed>\d+) passed"
    r"(?:, (?P<skipped>\d+) skipped)?(?:, (?P<errors>\d+) errors?)?.*)",
    re.M,
)
matches = list(pat.finditer(text))
# Prefer lines that look like pytest epilog (contain " in " with seconds)
epilog = [m for m in matches if " in " in m.group("summary")]
m = (epilog or matches)[-1] if (epilog or matches) else None
if not m:
    print("0 0 0 0")
    sys.exit(0)
g = m.groupdict()
print(f"{g.get('passed') or 0} {g.get('failed') or 0} {g.get('errors') or 0} {g.get('skipped') or 0}")
PY3
}
read -r PASSED FAILED ERRORS SKIPPED <<<"$(parse_summary)"
ELAPSED=$(awk -F= '/^elapsed_s=/{print $2}' "$META" 2>/dev/null || echo "?")
PEAK=$(awk -F= '/^peak_rss_mb=/{print $2}' "$META" 2>/dev/null || echo "?")
PATHS_META=$(awk -F= '/^paths=/{print substr($0,index($0,"=")+1)}' "$META" 2>/dev/null || echo "?")
FAIL_LINES=$( { rg -N '^FAILED |^ERROR ' "$LOG" || true; } | head -80 )
# Also pull failure headings if -q hid FAILED (shouldn't with -rfEs)
if [[ -z "$FAIL_LINES" ]]; then
  FAIL_LINES=$( { rg -N '^[_]{5,} .+ [_]+$' "$LOG" || true; } | sed -E 's/^_+\s+//; s/\s+_+$//' | head -80 )
fi

{
  echo "# koz3 test report: \`$REF\` @ \`$SHA\`"
  echo
  echo "- started: $START_ISO"
  echo "- finished: $END_ISO"
  echo "- resolved: \`$RESOLVED\` (\`$FULL\`)"
  echo "- worktree: \`$WT\`"
  echo "- venv: \`$VENV\` (CPU-only torch)"
  echo "- host: box «1» (8 CPU, low free RAM)"
  echo "- command: pytest -q -rfEs -p no:cacheprovider -p koz3_box_env ${TEST_PATHS[*]}"
  echo "- test paths: \`${TEST_PATHS[*]}\` (only dirs that exist on this branch)"
  echo "- wall time: ${ELAPSED}s"
  echo "- peak RSS: ${PEAK} MiB"
  echo "- exit: $TEST_RC"
  echo
  echo "## Counts"
  echo
  echo "| passed | failed | errors | skipped |"
  echo "|---:|---:|---:|---:|"
  echo "| $PASSED | $FAILED | $ERRORS | $SKIPPED |"
  echo
  echo "## pytest summary lines"
  echo
  echo '```'
  { rg -N '^[0-9]+ (failed|passed|error)' "$LOG" || true; }
  echo '```'
  echo
  if [[ -n "$FAIL_LINES" ]]; then
    echo "## Failures / errors (one line each)"
    echo
    echo '```'
    echo "$FAIL_LINES"
    echo '```'
    echo
  else
    echo "## Failures / errors"
    echo
    echo "none"
    echo
  fi
  echo "## Skip reasons (grouped)"
  echo
  echo '```'
  "$VENV/bin/python" - "$LOG" <<'PY2'
import re, sys
from collections import Counter
text = open(sys.argv[1], encoding="utf-8", errors="replace").read()
c = Counter()
for m in re.finditer(r"SKIPPED \[(\d+)\] [^:]+:\d+: (.+)", text):
    c[m.group(2).strip()] += int(m.group(1))
# also box env skips from short summary without file:line sometimes
for m in re.finditer(r"SKIPPED \[(\d+)\] (.+)", text):
    rest = m.group(2).strip()
    if re.match(r"\S+:\d+: ", rest):
        continue  # already counted
    c[rest] += int(m.group(1))
for k, v in c.most_common():
    print(f"{v:3d}  {k}")
print("TOTAL", sum(c.values()))
PY2
  echo '```'
  echo
  echo "## Notes"
  echo
  echo "- GPU/CUDA / missing submission weights / optional deps → skipped via \`koz3_box_env\` plugin (not counted as regressions)."
  echo "- Only existing dirs among \`tests/\`, \`centerhead/tests\` are passed to pytest (no exit-4 on missing centerhead)."
  echo "- Official metric (\`EXPDS_METRIC\`) and real competition samples are not on this box."
  echo "- Full log: \`$LOG\`"
  echo
  echo "Re-run: \`$0 $REF\`"
  echo "Cleanup worktree: \`$0 --cleanup $REF\`"
} > "$REPORT"
chmod a+rw "$REPORT" "$LOG" "$META" 2>/dev/null || true

echo
echo "REPORT: $REPORT"
echo "LOG:    $LOG"
echo "passed=$PASSED failed=$FAILED errors=$ERRORS skipped=$SKIPPED peak_rss_mb=$PEAK elapsed_s=$ELAPSED exit=$TEST_RC paths=${TEST_PATHS[*]}"
exit "$TEST_RC"
