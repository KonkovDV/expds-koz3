#!/usr/bin/env bash
# CPU test runner for KonkovDV/expds-koz3 on box «1».
# Usage:
#   /home/box/shared/koz3/box/run_tests.sh <branch-or-ref>
#   /home/box/shared/koz3/box/run_tests.sh --cleanup <branch-or-ref>
#   /home/box/shared/koz3/box/run_tests.sh --cleanup-all
#
# Does NOT push, does NOT modify main. Safe to re-run: worktree is reused/reset.
set -euo pipefail

REPO="${KOZ3_REPO:-/workspace/koz3-repo}"
VENV="${KOZ3_VENV:-/workspace/koz3-venv}"
WT_ROOT="${KOZ3_WT_ROOT:-/workspace/koz3-wt}"
RESULTS="${KOZ3_RESULTS:-/home/box/shared/koz3/box/results}"
SHARED_BOX="/home/box/shared/koz3/box"

sanitize() {
  echo "$1" | sed -E 's#[/\\ ]+#-#g; s#[^A-Za-z0-9._+-]#_#g; s#-+#-#g'
}

ensure_layout() {
  mkdir -p "$WT_ROOT" "$RESULTS"
  chmod a+rwx "$SHARED_BOX" "$RESULTS" "$WT_ROOT" 2>/dev/null || true
  chmod a+rwX "$SHARED_BOX" "$RESULTS" 2>/dev/null || true
}

cleanup_one() {
  local ref="$1"
  local name
  name="$(sanitize "$ref")"
  local wt="$WT_ROOT/$name"
  if [[ -d "$wt" ]]; then
    git -C "$REPO" worktree remove --force "$wt" 2>/dev/null \
      || { rm -rf "$wt"; git -C "$REPO" worktree prune; }
    echo "removed worktree: $wt"
  else
    echo "no worktree at $wt"
  fi
  if git -C "$REPO" show-ref --verify --quiet "refs/heads/wt/$name"; then
    git -C "$REPO" branch -D "wt/$name" 2>/dev/null || true
  fi
}

cleanup_all() {
  ensure_layout
  local d
  for d in "$WT_ROOT"/*; do
    [[ -d "$d" ]] || continue
    git -C "$REPO" worktree remove --force "$d" 2>/dev/null || rm -rf "$d"
  done
  git -C "$REPO" worktree prune
  echo "all worktrees under $WT_ROOT cleaned"
}

if [[ "${1:-}" == "--cleanup-all" ]]; then
  cleanup_all
  exit 0
fi
if [[ "${1:-}" == "--cleanup" ]]; then
  [[ -n "${2:-}" ]] || { echo "usage: $0 --cleanup <branch>"; exit 2; }
  cleanup_one "$2"
  exit 0
fi

REF="${1:-}"
if [[ -z "$REF" ]]; then
  echo "usage: $0 <branch-or-ref>"
  echo "       $0 --cleanup <branch-or-ref>"
  echo "       $0 --cleanup-all"
  exit 2
fi

ensure_layout

if [[ ! -d "$REPO/.git" ]]; then
  echo "ERROR: repo not found at $REPO" >&2
  exit 1
fi
if [[ ! -x "$VENV/bin/python" ]]; then
  echo "ERROR: venv not found at $VENV" >&2
  exit 1
fi

# Prefer rustup toolchain if present (system rustc may be too old for expds_core).
# shellcheck disable=SC1090
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env" || true
export PATH="$VENV/bin:${HOME}/.cargo/bin:${PATH}"
export VIRTUAL_ENV="$VENV"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-2}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-2}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-2}"
export NUMEXPR_NUM_THREADS="${NUMEXPR_NUM_THREADS:-2}"
export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-2}"

NAME="$(sanitize "$REF")"
WT="$WT_ROOT/$NAME"

echo "== fetch =="
git -C "$REPO" fetch --prune origin "+refs/heads/*:refs/remotes/origin/*" || \
  git -C "$REPO" fetch --prune origin

RESOLVED=""
if git -C "$REPO" rev-parse --verify --quiet "origin/$REF" >/dev/null; then
  RESOLVED="origin/$REF"
elif git -C "$REPO" rev-parse --verify --quiet "$REF" >/dev/null; then
  RESOLVED="$REF"
else
  echo "ERROR: cannot resolve ref '$REF'" >&2
  exit 1
fi
SHA="$(git -C "$REPO" rev-parse --short "$RESOLVED")"
FULL="$(git -C "$REPO" rev-parse "$RESOLVED")"
echo "ref=$REF resolved=$RESOLVED sha=$SHA"

echo "== worktree =="
if [[ -d "$WT/.git" || -f "$WT/.git" ]]; then
  git -C "$WT" fetch --quiet origin 2>/dev/null || true
  git -C "$WT" checkout --detach --force "$FULL"
  git -C "$WT" reset --hard "$FULL"
  git -C "$WT" clean -fdx -e target -e 'rust/**/target' 2>/dev/null || git -C "$WT" clean -fd
else
  [[ -d "$WT" ]] && rm -rf "$WT"
  git -C "$REPO" worktree add --detach "$WT" "$FULL"
fi
git -C "$WT" status -sb || true

REPORT="$RESULTS/${NAME}_${SHA}.md"
LOG="$RESULTS/${NAME}_${SHA}.log"
META="$RESULTS/${NAME}_${SHA}.meta"
rm -f "$LOG" "$META"
START_ISO="$(date '+%Y-%m-%d %H:%M:%S %Z')"
echo "== build rust (optional, best-effort) =="
(
  cd "$WT"
  if command -v maturin >/dev/null 2>&1 && command -v rustc >/dev/null 2>&1; then
    export RUSTFLAGS="${RUSTFLAGS:--C target-cpu=native}"
    maturin develop --release -m rust/expds_core/Cargo.toml \
      && "$VENV/bin/python" -c "import expds_core; print('expds_core', expds_core.version())" \
      || echo "WARN: expds_core build failed; tests will use NumPy fallbacks"
  else
    echo "WARN: maturin/rustc missing; skip Rust build"
  fi
) 2>&1 | tee -a "$LOG"

echo "== smoke import =="
(
  cd "$WT"
  "$VENV/bin/python" -m compileall -q expds scripts inference tests centerhead materials || true
  "$VENV/bin/python" -c "import expds.pipeline, expds.watchdog, expds.post, expds.metric; print('import ok')"
) 2>&1 | tee -a "$LOG"

echo "== pytest (CI-equivalent, low RAM) =="
set +e
"$VENV/bin/python" - "$WT" "$LOG" "$META" <<'PY'
import os, sys, time, subprocess, threading
from pathlib import Path
try:
    import psutil
except ImportError:
    psutil = None

wt, log_path, meta_path = Path(sys.argv[1]), Path(sys.argv[2]), Path(sys.argv[3])
runs = [
    ["-q", "-rs", "-p", "no:cacheprovider"],
    ["-q", "-rs", "-p", "no:cacheprovider", "centerhead/tests"],
]
env = os.environ.copy()
peak = 0
rc_all = 0
t0 = time.perf_counter()
vpy = Path(os.environ.get("VIRTUAL_ENV", "/workspace/koz3-venv")) / "bin" / "python"
with log_path.open("a", encoding="utf-8") as log:
    for args in runs:
        cmd = [str(vpy), "-m", "pytest", *args]
        header = f"\n### CMD: {' '.join(cmd)}\n"
        print(header, end="", flush=True)
        log.write(header); log.flush()
        proc = subprocess.Popen(
            cmd, cwd=str(wt), env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1
        )
        stop = False
        def monitor(p=proc):
            global peak
            if psutil is None:
                return
            try:
                pp = psutil.Process(p.pid)
            except Exception:
                return
            while not stop:
                try:
                    rss = pp.memory_info().rss
                    for c in pp.children(recursive=True):
                        try:
                            rss += c.memory_info().rss
                        except Exception:
                            pass
                    if rss > peak:
                        peak = rss
                except Exception:
                    pass
                time.sleep(0.25)
        th = threading.Thread(target=monitor, daemon=True)
        th.start()
        assert proc.stdout is not None
        for line in proc.stdout:
            sys.stdout.write(line); sys.stdout.flush()
            log.write(line)
        rc = proc.wait()
        stop = True
        th.join(timeout=2)
        rc_all = rc_all or rc
        footer = f"### EXIT {rc}\n"
        print(footer, end="", flush=True)
        log.write(footer); log.flush()

elapsed = time.perf_counter() - t0
meta_path.write_text(
    f"exit={rc_all}\nelapsed_s={elapsed:.1f}\npeak_rss_bytes={peak}\npeak_rss_mb={peak/1024/1024:.1f}\n",
    encoding="utf-8",
)
print(f"=== META exit={rc_all} elapsed={elapsed:.1f}s peak_rss_mb={peak/1024/1024:.1f} ===", flush=True)
sys.exit(rc_all)
PY
TEST_RC=$?
set -e
END_ISO="$(date '+%Y-%m-%d %H:%M:%S %Z')"

PASSED=$( { rg -oN '([0-9]+) passed' "$LOG" || true; } | awk '{s+=$1} END{print s+0}')
FAILED=$( { rg -oN '([0-9]+) failed' "$LOG" || true; } | awk '{s+=$1} END{print s+0}')
ERRORS=$( { rg -oN '([0-9]+) error' "$LOG" || true; } | awk '{s+=$1} END{print s+0}')
SKIPPED=$( { rg -oN '([0-9]+) skipped' "$LOG" || true; } | awk '{s+=$1} END{print s+0}')
ELAPSED=$(awk -F= '/^elapsed_s=/{print $2}' "$META" 2>/dev/null || echo "?")
PEAK=$(awk -F= '/^peak_rss_mb=/{print $2}' "$META" 2>/dev/null || echo "?")
FAIL_LINES=$( { rg -N '^FAILED |^ERROR ' "$LOG" || true; } | head -80)

{
  echo "# koz3 test report: \`$REF\` @ \`$SHA\`"
  echo
  echo "- started: $START_ISO"
  echo "- finished: $END_ISO"
  echo "- resolved: \`$RESOLVED\` (\`$FULL\`)"
  echo "- worktree: \`$WT\`"
  echo "- venv: \`$VENV\` (CPU-only torch)"
  echo "- host: box «1» (8 CPU, low free RAM)"
  echo "- command: pytest -q -rs -p no:cacheprovider  (+ centerhead/tests separately)"
  echo "- wall time: ${ELAPSED}s"
  echo "- peak RSS: ${PEAK} MiB"
  echo "- exit: $TEST_RC"
  echo
  echo "## Counts"
  echo
  echo "| passed | failed | errors | skipped |"
  echo "|---:|---:|---:|---:|"
  echo "| $PASSED | $FAILED | $ERRORS | $SKIPPED |"
  echo
  echo "## pytest summary lines"
  echo
  echo '```'
  { rg -N '^[0-9]+ passed' "$LOG" || true; }
  echo '```'
  echo
  if [[ -n "$FAIL_LINES" ]]; then
    echo "## Failures / errors (one line each)"
    echo
    echo '```'
    echo "$FAIL_LINES"
    echo '```'
    echo
  else
    echo "## Failures / errors"
    echo
    echo "none"
    echo
  fi
  echo "## Skip reasons (grouped)"
  echo
  echo '```'
  "$VENV/bin/python" - "$LOG" <<'PY2'
import re, sys
from collections import Counter
text = open(sys.argv[1], encoding="utf-8", errors="replace").read()
c = Counter()
for m in re.finditer(r"SKIPPED \[(\d+)\] [^:]+:\d+: (.+)", text):
    c[m.group(2).strip()] += int(m.group(1))
for k, v in c.most_common():
    print(f"{v:3d}  {k}")
print("TOTAL", sum(c.values()))
PY2
  echo '```'
  echo
  echo "## Notes"
  echo
  echo "- GPU/CUDA tests are skipped on this runner (CPU-only)."
  echo "- Missing submission files (pixgbm / rerank weights / geo_pixgbm.py) cause intentional skips."
  echo "- Official metric (\`EXPDS_METRIC\`) and real competition samples are not on this box."
  echo "- Full log: \`$LOG\`"
  echo
  echo "Re-run: \`$0 $REF\`"
  echo "Cleanup worktree: \`$0 --cleanup $REF\`"
} > "$REPORT"
chmod a+rw "$REPORT" "$LOG" "$META" 2>/dev/null || true

echo
echo "REPORT: $REPORT"
echo "LOG:    $LOG"
echo "passed=$PASSED failed=$FAILED errors=$ERRORS skipped=$SKIPPED peak_rss_mb=$PEAK elapsed_s=$ELAPSED exit=$TEST_RC"
exit "$TEST_RC"
