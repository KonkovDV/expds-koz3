diff --git a/expds/post.py b/expds/post.py
index eb7ce26..8d3685e 100644
--- a/expds/post.py
+++ b/expds/post.py
@@ -518,3 +518,112 @@ def kurgan_cross_modal_twins(feats: list[dict], spec: dict | None = None) -> lis
                 continue
             out.append(dict(f, class_name="kurgany_povrezhdennye", threshold_group="sp_focal_twin"))
     return out
+
+
+# --- Калибровка по группам + WBF-слияние разных групп (bot-2, п. 5 REPORT.md) ---
+# Флаг выключен по умолчанию. Честная офлайн-проверка (LOFO по семьям, 7 вариантов)
+# не прошла honest_accept: все Δ < 0 (см. koz3_shared/bot-2/REPORT2.md, раздел п. 5).
+FUSION_CALIB_ENABLED = False
+
+
+def _group_of(f: dict) -> str:
+    return f.get("threshold_group") or f.get("markup_type") or ""
+
+
+def calibrate_group_conf(feats: list[dict], calib: dict | None = None,
+                         enabled: bool | None = None) -> list[dict]:
+    """Пересчёт уверенности по (класс, группа).
+
+    calib[(класс, группа)] = ("platt", a, b): c' = sigmoid(a*logit(c)+b)
+                           | ("iso", xs, ys): кусочно-линейная интерполяция с отсечкой.
+    Нет записи — уверенность не меняется. Исходная сохраняется в confidence_raw.
+    """
+    if not (FUSION_CALIB_ENABLED if enabled is None else enabled) or not calib:
+        return feats
+    import bisect
+    out = []
+    for f in feats:
+        spec = calib.get((f["class_name"], _group_of(f)))
+        c = float(f.get("confidence", 1.0))
+        if spec is None:
+            out.append(f); continue
+        if spec[0] == "platt":
+            x = min(max(c, 1e-6), 1 - 1e-6)
+            z = spec[1] * math.log(x / (1 - x)) + spec[2]
+            cn = 1.0 / (1.0 + math.exp(-z))
+        else:
+            xs, ys = spec[1], spec[2]
+            if c <= xs[0]:
+                cn = ys[0]
+            elif c >= xs[-1]:
+                cn = ys[-1]
+            else:
+                k = bisect.bisect_right(xs, c)
+                x0, x1, y0, y1 = xs[k - 1], xs[k], ys[k - 1], ys[k]
+                cn = y0 if x1 == x0 else y0 + (y1 - y0) * (c - x0) / (x1 - x0)
+        out.append(dict(f, confidence=float(cn), confidence_raw=c))
+    return out
+
+
+def fuse_cross_group(feats: list[dict], how: str = "wbf",
+                     enabled: bool | None = None) -> list[dict]:
+    """WBF-подобное слияние ТОЛЬКО кластеров, где есть объекты из РАЗНЫХ групп.
+
+    Внутри (регион, markup_type, класс): union-find по пересечению с площадью > 0
+    между объектами разных групп. Остаётся лучший член (геометрия и группа его),
+    уверенность: how="wbf" — mean_g(max c группы) * min(N,T)/T (N — групп в
+    кластере, T — групп в (регион, markup, класс)); how="max" — max c.
+    Кластеры одной группы и EtGr не трогаются.
+    """
+    if not (FUSION_CALIB_ENABLED if enabled is None else enabled):
+        return feats
+    buckets: dict[tuple, list[int]] = defaultdict(list)
+    for i, f in enumerate(feats):
+        buckets[(f.get("region_name"), f.get("markup_type"), f["class_name"])].append(i)
+    drop: set[int] = set()
+    new_conf: dict[int, float] = {}
+    for key, idx in buckets.items():
+        if key[1] == "etgr" or len(idx) < 2:
+            continue
+        T = len({_group_of(feats[i]) for i in idx})
+        if T < 2:
+            continue
+        geoms = [feats[i]["geom"] for i in idx]
+        tree = STRtree(geoms)
+        parent = list(range(len(idx)))
+
+        def find(a: int) -> int:
+            while parent[a] != a:
+                parent[a] = parent[parent[a]]
+                a = parent[a]
+            return a
+
+        for a, g in enumerate(geoms):
+            ga = _group_of(feats[idx[a]])
+            for b in tree.query(g):
+                b = int(b)
+                if b <= a or _group_of(feats[idx[b]]) == ga:
+                    continue
+                if g.intersection(geoms[b]).area > 0:
+                    parent[find(a)] = find(b)
+        comps: dict[int, list[int]] = defaultdict(list)
+        for a in range(len(idx)):
+            comps[find(a)].append(idx[a])
+        for mem in comps.values():
+            if len(mem) < 2:
+                continue
+            mem.sort(key=lambda i: (-float(feats[i].get("confidence", 1.0)), i))
+            best = mem[0]
+            if how == "max":
+                val = float(feats[best].get("confidence", 1.0))
+            else:
+                gmax: dict[str, float] = {}
+                for i in mem:
+                    g = _group_of(feats[i])
+                    gmax[g] = max(gmax.get(g, -1.0), float(feats[i].get("confidence", 1.0)))
+                n = len(gmax)
+                val = sum(gmax.values()) / n * min(n, T) / T
+            new_conf[best] = val
+            drop.update(mem[1:])
+    return [dict(f, confidence=new_conf[i], fused=True) if i in new_conf else f
+            for i, f in enumerate(feats) if i not in drop]
diff --git a/scripts/fusion_calib_eval.py b/scripts/fusion_calib_eval.py
new file mode 100644
index 0000000..e8a4b45
--- /dev/null
+++ b/scripts/fusion_calib_eval.py
@@ -0,0 +1,190 @@
+"""Честная офлайн-оценка: калибровка уверенности по группам (OOF по семьям) и WBF только для
+кластеров из РАЗНЫХ групп порога (bot-2, п. 5 REPORT.md). Без переобучения моделей.
+
+Схема на каждый фолд семей F (фолды — из base_honest.pkl):
+  1) калибраторы (класс, группа) учатся на участках вне F; метка — попадание объекта
+     при исходных уверенностях (официальное жадное сопоставление);
+  2) калибровка применяется ко всем объектам; WBF (если включён) сливает кластеры;
+  3) жадное сопоставление заново (порядок по новым уверенностям);
+  4) пороги групп подбираются sweep_groups на участках вне F и применяются к F.
+Режимы пар: region — эталон только своего участка (как официальная метрика, режущая по участкам);
+            global — как expds.metric.build_curves (эталон любого участка того же класса).
+Запуск: OMP_NUM_THREADS=2 nice -n 10 /workspace/rerank/venv/bin/python scripts/fusion_calib_eval.py
+"""
+import argparse, json, pickle, sys, time
+from collections import Counter
+from pathlib import Path
+import numpy as np
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--repo", default="/workspace/expds-koz3")
+ap.add_argument("--prep", default="/workspace/koz3_shared/bot-2/work/fusion_prep.pkl")
+ap.add_argument("--base", default="/workspace/rerank/work/base_honest.pkl")
+ap.add_argument("--modes", default="global,region")
+ap.add_argument("--variants", default="base,platt,iso,wbf_raw,platt_wbf,iso_wbf,platt_max")
+ap.add_argument("--boot", type=int, default=1000)
+ap.add_argument("--out", default="/workspace/koz3_shared/bot-2/work/fusion_calib_eval.json")
+a = ap.parse_args()
+sys.path.insert(0, a.repo)
+from expds.metric import ClassCurve, sweep_groups, curve_where, score_counts, paired_bootstrap_counts
+from expds.naming import site_family
+from sklearn.linear_model import LogisticRegression
+from sklearn.isotonic import IsotonicRegression
+
+R = pickle.load(open(a.prep, "rb"))
+B = pickle.load(open(a.base, "rb"))
+folds = B["folds"]; every = set().union(*folds)
+ROOT = Path(a.repo)
+boxes = json.loads((ROOT / "notes" / "las_boxes_59.json").read_text(encoding="utf-8"))
+gt_regions_all = {r for c in R["classes"] for r in R["gt_region"][c]}
+optical = {r for r in gt_regions_all if r} - set(boxes)
+new = {l.strip() for l in (ROOT / "notes" / "regions_las_new.txt").read_text(encoding="utf-8").splitlines() if l.strip()}
+CL = R["classes"]
+MIN_POS = 10
+
+def greedy(c, ceff, active, mode):
+    P, pr = R["P"][c], R["pairs"][c]
+    m = pr["same"] if mode == "region" else np.ones(len(pr["i"]), bool)
+    pi, pj, ps = pr["i"][m], pr["j"][m], pr["s"][m]
+    keep = active[pi]; pi, pj, ps = pi[keep], pj[keep], ps[keep]
+    hit = np.zeros(len(P["conf"]), bool)
+    if not len(pi):
+        return hit
+    o = np.lexsort((pj, pi)); pi, pj, ps = pi[o], pj[o], ps[o]
+    starts = np.r_[0, np.flatnonzero(np.diff(pi)) + 1]; ends = np.r_[starts[1:], len(pi)]
+    preds = pi[starts]
+    order = np.lexsort((P["ord"][preds], -P["conf"][preds], -ceff[preds]))
+    matched = set()
+    for k in order.tolist():
+        best, bj = -np.inf, -1
+        for q in range(starts[k], ends[k]):
+            j = int(pj[q])
+            if j in matched: continue
+            if ps[q] > best + 1e-9: best, bj = ps[q], j
+        if bj >= 0:
+            matched.add(bj); hit[preds[k]] = True
+    return hit
+
+def curve(c, ceff, active, hit):
+    P = R["P"][c]
+    idx = np.flatnonzero(active)
+    o = idx[np.lexsort((P["ord"][idx], -P["conf"][idx], -ceff[idx]))]
+    gtc = Counter(R["gt_region"][c])
+    return ClassCurve(conf=ceff[o].astype(float), hit=hit[o], pred_region=P["region"][o].tolist(),
+                      n_gt=sum(gtc.values()), gt_regions=gtc, pred_group=P["group"][o].tolist())
+
+def logit(x):
+    x = np.clip(x, 1e-6, 1 - 1e-6); return np.log(x / (1 - x))
+
+def calibrate(c, kind, train_mask, label):
+    P = R["P"][c]; out = P["conf"].copy(); info = {}
+    for g in np.unique(P["group"]):
+        gm = P["group"] == g; tm = gm & train_mask
+        y = label[tm]; npos = int(y.sum()); nneg = int(len(y) - npos)
+        if npos < MIN_POS or nneg < MIN_POS:
+            info[g] = "identity"; continue
+        x = P["conf"][tm]
+        if kind == "platt":
+            lr = LogisticRegression(C=1e4, max_iter=1000).fit(logit(x)[:, None], y)
+            out[gm] = lr.predict_proba(logit(P["conf"][gm])[:, None])[:, 1]
+        else:
+            ir = IsotonicRegression(y_min=0, y_max=1, out_of_bounds="clip").fit(x, y)
+            out[gm] = ir.predict(P["conf"][gm])
+        info[g] = "fit"
+    return out, info
+
+T_CACHE = {}
+def groups_present(c):
+    if c not in T_CACHE:
+        P = R["P"][c]
+        key = np.char.add(np.char.add(P["region"].astype(str), "|"), P["markup"].astype(str))
+        T = {}
+        for k, g in zip(key.tolist(), P["group"].tolist()): T.setdefault(k, set()).add(g)
+        T_CACHE[c] = np.array([len(T[k]) for k in key.tolist()])
+    return T_CACHE[c]
+
+def fuse(c, ceff, how):
+    """Кластеры из разных групп -> один объект (геометрия лучшего члена, его группа)."""
+    P = R["P"][c]; cl = P["cluster"]; active = np.ones(len(cl), bool); ce = ceff.copy()
+    idx = np.flatnonzero(cl >= 0)
+    if not len(idx): return ce, active, 0
+    o = idx[np.lexsort((P["ord"][idx], -ceff[idx], cl[idx]))]          # по кластеру, лучший первым
+    starts = np.r_[0, np.flatnonzero(np.diff(cl[o])) + 1]; ends = np.r_[starts[1:], len(o)]
+    T = groups_present(c)
+    for s, e in zip(starts.tolist(), ends.tolist()):
+        mem = o[s:e]; best = mem[0]
+        if how == "max":
+            val = ceff[best]
+        else:
+            gmax = {}
+            for m_ in mem.tolist():
+                g = P["group"][m_]; gmax[g] = max(gmax.get(g, -np.inf), ceff[m_])
+            n = len(gmax); t = max(int(T[best]), n)
+            val = float(np.mean(list(gmax.values()))) * min(n, t) / t
+        ce[best] = val; active[mem[1:]] = False
+    return ce, active, len(starts)
+
+def run(variant, mode):
+    cal = {"platt": "platt", "iso": "isotonic", "platt_wbf": "platt", "iso_wbf": "isotonic", "platt_max": "platt"}.get(variant)
+    fus = {"wbf_raw": "wbf", "platt_wbf": "wbf", "iso_wbf": "wbf", "platt_max": "max"}.get(variant)
+    base_hit = {c: greedy(c, R["P"][c]["conf"], np.ones(len(R["P"][c]["conf"]), bool), mode) for c in CL}
+    counts = {c: {} for c in CL}; meta = {"fused_clusters": {}, "calib": {}}
+    static = cal is None
+    cache = None
+    for fi, held in enumerate(folds):
+        train = every - held
+        if not static or cache is None:
+            curves = {}
+            for c in CL:
+                P = R["P"][c]; ceff = P["conf"].copy()
+                if cal:
+                    tm = np.fromiter((r in train for r in P["region"]), bool, len(P["region"]))
+                    ceff, info = calibrate(c, cal, tm, base_hit[c]); meta["calib"].setdefault(c, Counter()).update(info.values())
+                active = np.ones(len(ceff), bool)
+                if fus:
+                    ceff, active, nf = fuse(c, ceff, fus); meta["fused_clusters"][c] = nf
+                hit = greedy(c, ceff, active, mode) if (cal or fus) else base_hit[c]
+                curves[c] = curve(c, ceff, active, hit)
+            cache = curves
+        curves = cache
+        res = sweep_groups({c: curve_where(cv, train) for c, cv in curves.items()})
+        taus = {}
+        for c, v in res.items():
+            for g, gv in v["groups"].items(): taus.setdefault(g, {})[c] = gv["threshold"]
+        for c, cv in curves.items():
+            hc = curve_where(cv, held); per = counts[c]
+            for r, n in hc.gt_regions.items(): per.setdefault(r, [0, 0, 0])[2] += int(n)
+            if hc.conf.size == 0: continue
+            tau = np.array([taus.get(g, {}).get(c, np.inf) for g in hc.pred_group])
+            kept = hc.conf >= tau
+            for r, h in zip(np.asarray(hc.pred_region, dtype=object)[kept], hc.hit[kept]):
+                per.setdefault(r, [0, 0, 0])[0 if h else 1] += 1
+    meta["calib"] = {c: dict(v) for c, v in meta["calib"].items()}
+    return counts, meta
+
+out = {"n_new": len(new), "n_optical": len(optical), "base_pkl": B["scores"], "modes": {}}
+t0 = time.time()
+for mode in a.modes.split(","):
+    res = {}; cnts = {}
+    for v in a.variants.split(","):
+        counts, meta = run(v, mode); cnts[v] = counts
+        s = [score_counts(counts)[0], score_counts(counts, new)[0], score_counts(counts, optical)[0]]
+        per = score_counts(counts)[1]
+        res[v] = {"honest": s[0], "new34": s[1], "no_lidar": s[2], "meta": meta,
+                  "per_class": {c: {k: round(x, 5) for k, x in d.items()} for c, d in per.items()}}
+        if v != "base":
+            b = res["base"]
+            res[v].update(d_honest=s[0] - b["honest"], d_new34=s[1] - b["new34"], d_no_lidar=s[2] - b["no_lidar"])
+            bs = paired_bootstrap_counts(counts, cnts["base"], site_family, n=a.boot)
+            res[v]["boot"] = bs
+            res[v]["honest_accept"] = bool(res[v]["d_honest"] >= 0.002 and bs.get("p_gt0", 0) >= 0.8
+                                           and res[v]["d_new34"] >= -0.001 and res[v]["d_no_lidar"] >= -0.001)
+        print(mode, v, [round(x, 6) for x in s], {k: res[v][k] for k in ("d_honest", "honest_accept") if k in res[v]},
+              res[v]["boot"].get("p_gt0") if "boot" in res[v] else "", round(time.time() - t0), flush=True)
+    if mode == "global":
+        res["base"]["pkl_counts_equal"] = all(
+            {r: list(x) for r, x in cnts["base"][c].items()} == {r: list(x) for r, x in B["counts"][c].items()}
+            for c in CL if c in B["counts"])
+    out["modes"][mode] = res
+    json.dump(out, open(a.out, "w"), ensure_ascii=False, indent=1, default=str)
+print("done", round(time.time() - t0))
diff --git a/scripts/fusion_calib_prep.py b/scripts/fusion_calib_prep.py
new file mode 100644
index 0000000..63bf364
--- /dev/null
+++ b/scripts/fusion_calib_prep.py
@@ -0,0 +1,122 @@
+"""Подготовка к офлайн-оценке калибровки и WBF (bot-2): один проход по участкам.
+
+Для каждого объекта стека: класс, уверенность, группа порога, markup, участок, порядок в файле.
+Пары (объект, эталон), прошедшие официальный _match_quality (cov ≥ 0.5 и точка внутри),
+с признаком «эталон того же участка» (официальная метрика режет по участкам; build_curves в репо — нет).
+Кластеры для WBF: пересекающиеся (площадь > 0) объекты одного (участок, markup, класс)
+из РАЗНЫХ групп порога, union-find.
+Читает work/stack_regions/*.jsonl (потоковая разбивка стека), эталон — целиком (он мал).
+"""
+import argparse, json, pickle, sys, time
+from collections import defaultdict
+from pathlib import Path
+import numpy as np
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--repo", default="/workspace/expds-koz3")
+ap.add_argument("--regions-dir", default="/workspace/koz3_shared/bot-2/work/stack_regions")
+ap.add_argument("--gt", default="/workspace/rerank/gt_train_v2.geojson")
+ap.add_argument("--shm", default="/workspace/koz3_shared/bot-2/work/shm")
+ap.add_argument("--out", default="/workspace/koz3_shared/bot-2/work/fusion_prep.pkl")
+a = ap.parse_args()
+sys.path.insert(0, a.repo)
+import shapely
+from shapely.strtree import STRtree
+import expds.metric as M
+M._SHM_CACHE_DIR = Path(a.shm)
+from expds.metric import load_official, _collect
+
+mod = load_official(str(Path(a.repo) / "materials" / "compute_metrics.py"))
+calc = mod.F1Calculator()
+CLASSES = list(calc.target_classes)
+SEP = "\x00"
+
+gtfc = json.loads(Path(a.gt).read_bytes())
+n_sub = sum(1 for f in gtfc["features"] if (f.get("properties") or {}).get("sub_region_name"))
+G = _collect(mod, calc, gtfc, True)
+gt_geom = {c: [x[0] for x in G.get(c, [])] for c in CLASSES}
+gt_reg = {c: [x[2] for x in G.get(c, [])] for c in CLASSES}
+gt_tree = {c: STRtree([x.buffer(calc.r_tolerance) if x.geom_type == "Point" else x for x in gt_geom[c]])
+           if gt_geom[c] else None for c in CLASSES}
+del gtfc
+M._UTM_GEOM_CACHE.clear()
+
+P = {c: defaultdict(list) for c in CLASSES}          # c -> поле -> список
+pairs = {c: [] for c in CLASSES}                     # (local_idx, gt_idx, score, same_region)
+n_cluster = 0; stats = defaultdict(int)
+t0 = time.time()
+files = sorted(Path(a.regions_dir).glob("*.jsonl"))
+for fi, fp in enumerate(files):
+    feats = [json.loads(l) for l in open(fp)]
+    markup_of = {}
+    for f in feats:
+        p = f["properties"]; markup_of[p["_ord"]] = str(p.get("markup_type") or "")
+        p["region_name"] = f'{p.get("region_name", "default_source")}{SEP}{p["_ord"]}'
+    out = _collect(mod, calc, {"features": feats}, False)
+    M._UTM_GEOM_CACHE.clear(); del feats
+    for c in CLASSES:
+        items = out.get(c, [])
+        if not items:
+            continue
+        base = len(P[c]["conf"])
+        geoms = [x[0] for x in items]
+        for g, conf, rr, grp in items:
+            reg, o = rr.rsplit(SEP, 1); o = int(o)
+            P[c]["conf"].append(conf); P[c]["ord"].append(o); P[c]["region"].append(reg)
+            P[c]["group"].append(grp); P[c]["markup"].append(markup_of[o])
+        # пары с эталоном (по всем участкам, отмечаем «свой» участок)
+        if gt_tree[c] is not None:
+            qp, qg = gt_tree[c].query(geoms)
+            for i, j in zip(qp.tolist(), qg.tolist()):
+                pg = geoms[i]
+                if pg.geom_type != "Polygon":
+                    continue
+                ok, s = calc._match_quality(pg, gt_geom[c][j])
+                if ok:
+                    same = gt_reg[c][j] == P[c]["region"][base + i]
+                    pairs[c].append((base + i, j, float(s), same)); stats["pairs_same" if same else "pairs_cross"] += 1
+        # кластеры из разных групп в пределах (markup) — участок и класс уже общие
+        cl = np.full(len(items), -1, dtype=np.int64)
+        grp_arr = np.array([x[3] for x in items], dtype=object)
+        mk_arr = np.array([markup_of[int(x[2].rsplit(SEP, 1)[1])] for x in items], dtype=object)
+        if len(set(grp_arr.tolist())) > 1:
+            garr = np.array(geoms, dtype=object)
+            tree = STRtree(garr)
+            qi, qj = tree.query(garr, predicate="intersects")
+            m = (qi < qj) & (grp_arr[qi] != grp_arr[qj]) & (mk_arr[qi] == mk_arr[qj])
+            qi, qj = qi[m], qj[m]
+            if len(qi):
+                area = shapely.area(shapely.intersection(garr[qi], garr[qj]))
+                keep = area > 0
+                qi, qj = qi[keep], qj[keep]
+                parent = np.arange(len(items))
+                def find(x):
+                    while parent[x] != x:
+                        parent[x] = parent[parent[x]]; x = parent[x]
+                    return x
+                for i, j in zip(qi.tolist(), qj.tolist()):
+                    ri, rj = find(i), find(j)
+                    if ri != rj: parent[ri] = rj
+                roots = np.array([find(i) for i in range(len(items))])
+                cnt = np.bincount(roots, minlength=len(items))
+                multi = np.flatnonzero(cnt[roots] > 1)
+                if len(multi):
+                    uniq, inv = np.unique(roots[multi], return_inverse=True)
+                    cl[multi] = n_cluster + inv; n_cluster += len(uniq)
+                    stats[f"clustered|{c}"] += len(multi)
+        P[c]["cluster"].extend(cl.tolist())
+    if fi % 20 == 0:
+        print(fi, len(files), fp.stem, round(time.time() - t0), flush=True)
+
+res = {"classes": CLASSES, "n_gt_sub_region": n_sub, "stats": dict(stats), "n_cluster": n_cluster,
+       "gt_region": gt_reg, "P": {}, "pairs": {}}
+for c in CLASSES:
+    d = P[c]
+    res["P"][c] = {"conf": np.array(d["conf"], float), "ord": np.array(d["ord"], np.int64),
+                   "region": np.array(d["region"], object), "group": np.array(d["group"], object),
+                   "markup": np.array(d["markup"], object), "cluster": np.array(d["cluster"], np.int64)}
+    pr = pairs[c]
+    res["pairs"][c] = {"i": np.array([x[0] for x in pr], np.int64), "j": np.array([x[1] for x in pr], np.int64),
+                       "s": np.array([x[2] for x in pr], float), "same": np.array([x[3] for x in pr], bool)}
+pickle.dump(res, open(a.out, "wb"), protocol=pickle.HIGHEST_PROTOCOL)
+print("done", round(time.time() - t0), dict(stats), n_cluster, "gt_sub", n_sub)
