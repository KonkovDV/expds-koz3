index 0000000..695b854
--- /dev/null
+++ b/scripts/merge_mintau.py
@@ -0,0 +1,41 @@
+"""bot-2, merge-check: минимальный честный порог (группа, класс) по 10 фолдам A (оба режима сопоставления) —
+фильтр для чувствительности S (объекты ниже ни в одном фолде не выдаются и склеиться не могут)."""
+import json, pickle, sys
+from collections import Counter
+import numpy as np
+sys.path.insert(0, "/workspace/expds-koz3")
+from expds.metric import ClassCurve, sweep_groups, curve_where, family_folds
+from expds.naming import site_family
+R = pickle.load(open("/workspace/koz3_shared/bot-2/work/fusion_prep.pkl", "rb"))
+B = pickle.load(open("/workspace/rerank/work/base_honest.pkl", "rb"))
+CL = R["classes"]; every = set().union(*B["folds"]); folds = family_folds(every, site_family, 10)
+def greedy(c, mode):
+    P, pr = R["P"][c], R["pairs"][c]; ceff = P["conf"]
+    m = pr["same"] if mode == "region" else np.ones(len(pr["i"]), bool)
+    pi, pj, ps = pr["i"][m], pr["j"][m], pr["s"][m]; hit = np.zeros(len(ceff), bool)
+    if not len(pi): return hit
+    o = np.lexsort((pj, pi)); pi, pj, ps = pi[o], pj[o], ps[o]
+    st = np.r_[0, np.flatnonzero(np.diff(pi)) + 1]; en = np.r_[st[1:], len(pi)]
+    preds = pi[st]; order = np.lexsort((P["ord"][preds], -ceff[preds])); mt = set()
+    for k in order.tolist():
+        best, bj = -np.inf, -1
+        for q in range(st[k], en[k]):
+            j = int(pj[q])
+            if j in mt: continue
+            if ps[q] > best + 1e-9: best, bj = ps[q], j
+        if bj >= 0: mt.add(bj); hit[preds[k]] = True
+    return hit
+mn = {}
+for mode in ("global", "region"):
+    cur = {}
+    for c in CL:
+        P = R["P"][c]; h = greedy(c, mode); o = np.lexsort((P["ord"], -P["conf"])); g = Counter(R["gt_region"][c])
+        cur[c] = ClassCurve(conf=P["conf"][o].astype(float), hit=h[o], pred_region=P["region"][o].tolist(),
+                            n_gt=sum(g.values()), gt_regions=g, pred_group=P["group"][o].tolist())
+    for held in folds:
+        res = sweep_groups({c: curve_where(cv, every - held) for c, cv in cur.items()})
+        for c, v in res.items():
+            for g, gv in v["groups"].items():
+                k = f"{g}|{c}"; mn[k] = min(mn.get(k, np.inf), float(gv["threshold"]))
+json.dump(mn, open("/workspace/koz3_shared/bot-2/work/merge/min_tau.json", "w"), indent=1)
+print({k: v for k, v in sorted(mn.items())})
diff --git a/scripts/stack_split_regions.py b/scripts/stack_split_regions.py
new file mode 100644
index 0000000..c666212
--- /dev/null
+++ b/scripts/stack_split_regions.py
@@ -0,0 +1,33 @@
+"""Потоковая разбивка большого стека (FeatureCollection) по участкам в JSONL без загрузки целиком.
+python stack_split_regions.py <stack.geojson> <outdir>   — открывает стек только на чтение."""
+import json, sys, os, collections
+src, outdir = sys.argv[1], sys.argv[2]
+os.makedirs(outdir, exist_ok=True)
+dec = json.JSONDecoder(); buf = ""; started = False; files = {}
+stat = collections.Counter(); keys = collections.Counter(); n = 0
+with open(src, "r") as f:
+    while True:
+        chunk = f.read(8 << 20); buf += chunk
+        if not started:
+            i = buf.find('"features": ['); buf = buf[i + 13:]; started = True
+        pos = 0
+        while True:
+            while pos < len(buf) and buf[pos] in " ,\n\r\t": pos += 1
+            if pos >= len(buf) or buf[pos] == "]": break
+            try: obj, end = dec.raw_decode(buf, pos)
+            except json.JSONDecodeError: break
+            p = obj.get("properties") or {}
+            r = str(p.get("region_name", "default_source"))
+            if p.get("sub_region_name"): stat["has_sub_region"] += 1
+            stat["|".join(map(str, (p.get("markup_type"), p.get("threshold_group") or "", p.get("class_name"))))] += 1
+            for k in p: keys[k] += 1
+            if r not in files: files[r] = open(os.path.join(outdir, r + ".jsonl"), "w")
+            p["_ord"] = n                                  # порядок в исходном файле (для тай-брейка как в build_curves)
+            files[r].write(json.dumps(obj, ensure_ascii=False) + "\n"); n += 1
+            pos = end
+        buf = buf[pos:]
+        if not chunk: break
+for v in files.values(): v.close()
+json.dump({"n": n, "regions": len(files), "counts": dict(stat), "prop_keys": dict(keys)},
+          open(os.path.join(outdir, "_summary.json"), "w"), ensure_ascii=False, indent=1)
+print(n, len(files))
diff --git a/tests/test_fusion_calib.py b/tests/test_fusion_calib.py
new file mode 100644
index 0000000..3f4a05a
--- /dev/null
+++ b/tests/test_fusion_calib.py
@@ -0,0 +1,34 @@
+from shapely.geometry import box
+
+from expds import post
+
+
+def f(x, g, c, cls="kurgany_tselye"):
+    return {"geom": box(x, 0, x + 1, 1), "region_name": "r", "markup_type": "li",
+            "threshold_group": g, "class_name": cls, "confidence": c}
+
+
+def test_off_by_default():
+    feats = [f(0, "a", 0.9), f(0.5, "b", 0.3)]
+    assert post.fuse_cross_group(feats) == feats
+    assert post.calibrate_group_conf(feats, {("kurgany_tselye", "a"): ("platt", 1.0, 1.0)}) == feats
+
+
+def test_fuse_only_different_groups():
+    feats = [f(0, "a", 0.9), f(0.5, "b", 0.3), f(0.2, "a", 0.8), f(5, "a", 0.5)]
+    out = post.fuse_cross_group(feats, enabled=True)
+    # кластер {0,1,2} (разные группы через 1) -> один объект; 3 не тронут
+    assert len(out) == 2
+    fused = [o for o in out if o.get("fused")][0]
+    assert abs(fused["confidence"] - (0.9 + 0.3) / 2) < 1e-9   # N=T=2
+    same = [f(0, "a", 0.9), f(0.5, "a", 0.3)]
+    assert post.fuse_cross_group(same, enabled=True) == same
+
+
+def test_calib_iso_platt():
+    feats = [f(0, "a", 0.5), f(3, "b", 0.5)]
+    cal = {("kurgany_tselye", "a"): ("iso", [0.0, 1.0], [0.0, 0.2])}
+    out = post.calibrate_group_conf(feats, cal, enabled=True)
+    assert abs(out[0]["confidence"] - 0.1) < 1e-9 and out[1]["confidence"] == 0.5
+    out = post.calibrate_group_conf(feats, {("kurgany_tselye", "b"): ("platt", 1.0, 0.0)}, enabled=True)
+    assert abs(out[1]["confidence"] - 0.5) < 1e-9
