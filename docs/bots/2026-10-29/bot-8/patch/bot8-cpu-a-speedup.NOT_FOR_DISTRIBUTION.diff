+def test_band_fill_keeps_network_input(monkeypatch):
+    """Band 80 m ⊇ receptive field of all relief channels: x12 equals the exact-fill x12 (only the sign of the zeros on
+    invalid pixels, value·0, may differ), and so does a network's heatmap."""
+    from expds.li_a import dtm
+    g = _ground(700, 1400)
+    d0, v0 = dtm.fill(g, 0.25, "exact")
+    monkeypatch.setattr(dtm, "TILE_PX", 256)
+    d1, v1 = dtm.fill(g, 0.25, "band")
+    assert np.array_equal(v0, v1) and not np.array_equal(d0, d1)   # far cells do differ
+    x0, _ = expert._channels_extra(d0, v0, 0.25, dev=DEV, with_valid=True)
+    x1, _ = expert._channels_extra(d1, v1, 0.25, dev=DEV, with_valid=True)
+    assert np.array_equal(x0, x1)
+    diff = x0.view(np.uint32) != x1.view(np.uint32)
+    assert (x0[diff] == 0).all()
+    p0 = hm.predict_tiled(_Net(12, 3), x0, N_HM + N_MK, tile=256, overlap=64, tta=False, dev=DEV)
+    p1 = hm.predict_tiled(_Net(12, 3), x1, N_HM + N_MK, tile=256, overlap=64, tta=False, dev=DEV)
+    assert np.array_equal(p0, p1)
+
