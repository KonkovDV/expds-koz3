+++ b/expds/li_a/dtm.py
@@ -0,0 +1,265 @@
+"""LAS → DTM (shared by training prep and inference).
+
+Ground = class 2 when it makes up ≥ 5 % of points; otherwise per-cell minimum + progressive morphological filter.
+Points are streamed in chunks, so multi-GB clouds fit in memory. Cells without ground are filled from the nearest
+ground cell and marked invalid if farther than FILL_M.
+"""
+import os
+
+import numpy as np
+from scipy import ndimage as ndi
+
+RES = 0.25
+FILL_M = 3.0
+MAX_CELLS = 250_000_000
+
+
+def _bounds(path):
+    import laspy
+    with laspy.open(path) as r:
+        h = r.header
+        return h.mins, h.maxs, h.point_count
+
+
+def ground_fraction(path, sample=2_000_000):
+    import laspy
+    with laspy.open(path) as r:
+        for pts in r.chunk_iterator(sample):
+            c = np.asarray(pts.classification)
+            return float((c == 2).mean())
+    return 0.0
+
+
+def is_ground_only(path, sample=2_000_000, cell=1.0, max_spread=0.6):
+    """True when the cloud is already ground-only (e.g. training site 101: all class 8). Within 1 m cells the vertical
+    spread of a bare-earth cloud is small; vegetation / buildings give metres. PMF on such clouds shaves mounds."""
+    import laspy
+    with laspy.open(path) as r:
+        for pts in r.chunk_iterator(sample):
+            x, y, z = np.asarray(pts.x), np.asarray(pts.y), np.asarray(pts.z)
+            k = ((x - x.min()) // cell).astype(np.int64) * 1_000_003 + ((y - y.min()) // cell).astype(np.int64)
+            order = np.argsort(k); k, z = k[order], z[order]
+            starts = np.r_[0, np.nonzero(np.diff(k))[0] + 1]
+            zmax = np.maximum.reduceat(z, starts); zmin = np.minimum.reduceat(z, starts)
+            n = np.diff(np.r_[starts, len(k)])
+            spread = (zmax - zmin)[n >= 3]
+            return bool(spread.size) and float(np.percentile(spread, 95)) < max_spread
+    return False
+
+
+def build(path, res=RES):
+    """→ dtm float32 (H,W) (NaN-free), valid bool (H,W), (x0, y_top, res) grid origin in the LAS CRS."""
+    import laspy
+    mins, maxs, n = _bounds(path)
+    while ((maxs[0] - mins[0]) / res) * ((maxs[1] - mins[1]) / res) > MAX_CELLS:
+        res *= 2
+    x0, y1 = np.floor(mins[0]), np.ceil(maxs[1])
+    W = int(np.ceil((maxs[0] - x0) / res)) + 1
+    H = int(np.ceil((y1 - mins[1]) / res)) + 1
+    use_class = ground_fraction(path) >= 0.05
+    all_ground = (not use_class) and is_ground_only(path)
+    zsum = np.zeros(H * W, np.float64); cnt = np.zeros(H * W, np.int32)
+    zmin = np.full(H * W, np.inf, np.float32)
+    with laspy.open(path) as r:
+        for pts in r.chunk_iterator(5_000_000):
+            x, y, z = np.asarray(pts.x), np.asarray(pts.y), np.asarray(pts.z, np.float32)
+            if use_class:
+                m = np.asarray(pts.classification) == 2
+                x, y, z = x[m], y[m], z[m]
+            else:
+                m = np.isin(np.asarray(pts.classification), (7, 18), invert=True)   # drop flagged noise
+                x, y, z = x[m], y[m], z[m]
+            ix = ((x - x0) / res).astype(np.int64); iy = ((y1 - y) / res).astype(np.int64)
+            ok = (ix >= 0) & (ix < W) & (iy >= 0) & (iy < H)
+            k = iy[ok] * W + ix[ok]
+            if use_class or all_ground:
+                zsum += np.bincount(k, z[ok], minlength=H * W); cnt += np.bincount(k, minlength=H * W).astype(np.int32)
+            else:
+                np.minimum.at(zmin, k, z[ok])
+    if use_class or all_ground:
+        has = cnt > 0
+        g = np.where(has, zsum / np.maximum(cnt, 1), np.nan).astype(np.float32).reshape(H, W)
+    else:
+        g = np.where(np.isfinite(zmin), zmin, np.nan).reshape(H, W)
+        g = pmf(g, res)
+    dtm, valid = fill(g, res)
+    return dtm.astype(np.float32), valid, (float(x0), float(y1), float(res))
+
+
+# §7.12 (3) (bot-8): nearest-ground fill. "exact" = upstream; "exact_fast" = the same fill from an indices-only EDT
+# with the validity test done on integer d2, gather + smoothing in row blocks on threads (byte-equal); "band" = tiled
+# EDT on threads, exact for every cell within BAND_M of ground; cells farther away (outside the survey, invalid) take
+# the ground value of the nearest coarse block. BAND_M = 80 m covers the whole receptive field of the relief channels
+# from any valid pixel (widest: LRM25 = avg_pool 8 + 19-tap blur at 4 m + bilinear ≈ 89 px = 44.5 m; openness 10 m;
+# fill smoothing 1 m; validity 3 m), so the network input (x9/x12, zero on invalid pixels) is unchanged by construction
+# (equal values; only the sign of value·0 on invalid pixels may differ) — checked on 001 and 022
+# (bench/cpu_a_speedup/edt_band_channels_*.json) and in tests. A band below ~50 m changes LRM10/25 on valid pixels.
+FILL_MODE = os.environ.get("LI_A_FILL", "exact_fast")   # byte-equal to "exact"; "band" is opt-in
+BAND_M = float(os.environ.get("LI_A_BAND_M", "80"))
+TILE_PX = int(os.environ.get("LI_A_TILE_PX", "4096"))      # EDT tile; window = tile + 2·band
+ROW_BLOCK = 1024                                               # row blocks for the d2 test / gather / smoothing
+FILL_THREADS = int(os.environ.get("LI_A_FILL_THREADS", os.environ.get("EXPDS_THREADS", "2")))
+
+
+def fill(g, res, mode=None):
+    """g (H,W) float32 with NaN where no ground → (dtm, valid) as in upstream dtm.build."""
+    mode = mode or FILL_MODE
+    has = np.isfinite(g)
+    filled = ~has
+    if mode == "exact":
+        dist, (iy_, ix_) = ndi.distance_transform_edt(~has, return_indices=True)
+        dtm = g[iy_, ix_]
+        if filled.any():
+            sm = ndi.gaussian_filter(dtm, 1.0)
+            dtm = np.where(filled, sm, dtm)
+        valid = dist * res <= FILL_M
+        return dtm, valid
+    if mode == "exact_fast":
+        iy_, ix_ = ndi.distance_transform_edt(~has, return_distances=False, return_indices=True)
+        valid = np.empty(has.shape, bool)
+        for y in range(0, has.shape[0], ROW_BLOCK):    # row blocks: the d2 temporaries stay small
+            valid[y:y + ROW_BLOCK] = _valid_from_indices(iy_[y:y + ROW_BLOCK], ix_[y:y + ROW_BLOCK], res, y0=y)[0]
+    elif mode == "band":
+        iy_, ix_, valid = _band_indices(has, res)
+    else:
+        raise ValueError(f"fill mode {mode!r}")
+    return _gather_smooth(g, iy_, ix_, filled), valid
+
+
+def _gather_smooth(g, iy_, ix_, filled, rows=ROW_BLOCK, threads=None):
+    """= upstream `dtm = g[iy_, ix_]; dtm = where(filled, gaussian_filter(dtm, 1.0), dtm)`, in row blocks on threads.
+
+    gaussian_filter(σ=1, truncate=4) reaches 4 rows; each block is filtered with a 4-row halo, so the separable passes
+    do the same float operations for every kept row (reflect only at the true image edges) — byte-equal."""
+    from concurrent.futures import ThreadPoolExecutor
+    H = g.shape[0]
+    dtm = g[iy_, ix_] if H <= rows else np.empty(iy_.shape, g.dtype)
+    if H <= rows:
+        return np.where(filled, ndi.gaussian_filter(dtm, 1.0), dtm) if filled.any() else dtm
+    R = 4                                 # = int(truncate · σ + 0.5)
+
+    def gather(y):
+        dtm[y:y + rows] = g[iy_[y:y + rows], ix_[y:y + rows]]
+    ys = list(range(0, H, rows))
+    with ThreadPoolExecutor(max(1, threads or FILL_THREADS)) as ex:
+        list(ex.map(gather, ys))
+        if not filled.any():
+            return dtm
+        out = np.empty_like(dtm)
+
+        def smooth(y):
+            ya, yb = max(0, y - R), min(H, y + rows + R)
+            sm = ndi.gaussian_filter(dtm[ya:yb], 1.0)[y - ya:y - ya + min(rows, H - y)]
+            out[y:y + rows] = np.where(filled[y:y + rows], sm, dtm[y:y + rows])
+        list(ex.map(smooth, ys))
+    return out
+
+
+def _d2_max(res):
+    """Largest integer d2 with sqrt(d2)·res ≤ FILL_M in float64 — the upstream test `dist * res <= FILL_M` with scipy's
+    dist = sqrt(dy² + dx²) is monotone in the integer d2, so `d2 <= _d2_max(res)` is the same mask."""
+    t = int((FILL_M / res) ** 2) + 2
+    while t >= 0 and not (np.sqrt(np.float64(t)) * res <= FILL_M):
+        t -= 1
+    assert not (np.sqrt(np.float64(t + 1)) * res <= FILL_M)
+    return t
+
+
+def _valid_from_indices(iy_, ix_, res, y0=0, x0=0):
+    """→ (valid as upstream, integer d2); int32 math (|dy|, |dx| < 46341 within a row block / window)."""
+    H, W = iy_.shape
+    dy = iy_ - np.arange(y0, y0 + H, dtype=np.int32)[:, None]
+    dx = ix_ - np.arange(x0, x0 + W, dtype=np.int32)[None, :]
+    if max(H, W) > 46340 or (dx.size and max(abs(int(dx.min())), abs(int(dx.max()))) > 46340):
+        dy, dx = dy.astype(np.int64), dx.astype(np.int64)
+    d2 = dy * dy; d2 += dx * dx
+    return d2 <= _d2_max(res), d2
+
+
+def _band_indices(has, res, band_m=None, tile=None, threads=None):
+    """Tiled nearest-ground indices: exact within band_m of ground, nearest coarse block beyond."""
+    from concurrent.futures import ThreadPoolExecutor
+    band = max(int(np.ceil((band_m or BAND_M) / res)), int(np.ceil(FILL_M / res)) + 2)
+    tile = tile or TILE_PX
+    B = 32
+    tile = max(B, tile // B * B)
+    H, W = has.shape
+    iy_ = np.empty((H, W), np.int32); ix_ = np.empty((H, W), np.int32)
+    valid = np.zeros((H, W), bool)
+    CY, CX = _coarse_nearest(has, B)
+
+    def coarse(y0, y1, x0, x1):
+        cy = np.repeat(np.repeat(CY[y0 // B:-(-y1 // B), x0 // B:-(-x1 // B)], B, 0), B, 1)[:y1 - y0, :x1 - x0]
+        cx = np.repeat(np.repeat(CX[y0 // B:-(-y1 // B), x0 // B:-(-x1 // B)], B, 0), B, 1)[:y1 - y0, :x1 - x0]
+        return cy, cx
+
+    def one(t):
+        y0, x0 = t
+        y1, x1 = min(H, y0 + tile), min(W, x0 + tile)
+        ya, xa, yb, xb = max(0, y0 - band), max(0, x0 - band), min(H, y1 + band), min(W, x1 + band)
+        hw = has[ya:yb, xa:xb]
+        if not hw.any():
+            iy_[y0:y1, x0:x1], ix_[y0:y1, x0:x1] = coarse(y0, y1, x0, x1)
+            return
+        jy, jx = ndi.distance_transform_edt(~hw, return_distances=False, return_indices=True)
+        jy = jy[y0 - ya:y1 - ya, x0 - xa:x1 - xa]; jx = jx[y0 - ya:y1 - ya, x0 - xa:x1 - xa]
+        jy += ya; jx += xa
+        v, d2 = _valid_from_indices(jy, jx, res, y0, x0)
+        far = d2 > band * band          # nearest ground may lie outside the window: not exact → coarse fallback
+        if far.any():
+            cy, cx = coarse(y0, y1, x0, x1)
+            jy = np.where(far, cy, jy); jx = np.where(far, cx, jx)
+        iy_[y0:y1, x0:x1] = jy; ix_[y0:y1, x0:x1] = jx; valid[y0:y1, x0:x1] = v   # far ⇒ d2 > band² ⇒ not valid
+    tiles = [(y, x) for y in range(0, H, tile) for x in range(0, W, tile)]
+    with ThreadPoolExecutor(max(1, threads or FILL_THREADS)) as ex:   # scipy's EDT and numpy ufuncs release the GIL
+        list(ex.map(one, tiles))
+    return iy_, ix_, valid
+
+
+def _coarse_nearest(has, B):
+    """Per B×B block: indices of a ground cell (first in the block) of the nearest ground-bearing block (Hb, Wb)."""
+    H, W = has.shape
+    Hb, Wb = -(-H // B), -(-W // B)
+    hp = np.zeros((Hb * B, Wb * B), bool); hp[:H, :W] = has
+    blk = hp.reshape(Hb, B, Wb, B).transpose(0, 2, 1, 3).reshape(Hb, Wb, B * B)
+    anyg = blk.any(-1); first = blk.argmax(-1)
+    del blk, hp
+    if not anyg.any():
+        z = np.zeros((Hb, Wb), np.int32)
+        return z, z
+    by, bx = ndi.distance_transform_edt(~anyg, return_distances=False, return_indices=True)
+    k = first[by, bx]
+    return (by * B + k // B).astype(np.int32), (bx * B + k % B).astype(np.int32)
+
+
+def pmf(zmin, res, slope=0.3, dh0=0.3, dh_max=3.0, windows_m=(1, 2, 4, 8, 16)):
+    """Progressive morphological filter (Zhang et al. 2003) on a min-z grid; non-ground cells → NaN."""
+    g = zmin.copy()
+    fill = np.isnan(g)
+    if fill.all():
+        return g
+    _, (iy, ix) = ndi.distance_transform_edt(fill, return_indices=True)
+    surf = g[iy, ix]
+    ground = ~fill
+    prev = 0.0
+    for w in windows_m:
+        k = max(3, int(round(w / res)) | 1)
+        opened = ndi.grey_opening(surf, size=(k, k))
+        dh = min(dh_max, dh0 + slope * (w - prev)) if prev else dh0
+        ground &= (surf - opened) <= dh
+        surf = opened
+        prev = w
+    out = zmin.copy()
+    out[~ground] = np.nan
+    return out
+
+
+def save(path_out, dtm, valid, origin, crs):
+    zo = float(np.floor(dtm[valid].min())) if valid.any() else 0.0
+    q = np.clip(np.round((dtm - zo) * 100), 0, 65535).astype(np.uint16)
+    np.savez_compressed(path_out, dtm_cm=q, z0=zo, valid=valid, origin=np.array(origin), crs=str(crs))
+
+
+def load(path):
+    z = np.load(path)
+    return z["dtm_cm"].astype(np.float32) / 100 + float(z["z0"]), z["valid"], tuple(z["origin"]), str(z["crs"])
