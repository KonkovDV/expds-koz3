--- /dev/null
+++ b/expds/li_a/expert.py
@@ -0,0 +1,160 @@
+"""LiDAR expert (scenario (a)): LAS → DTM → relief channels → U-Net ensemble → peaks.
+
+Port of EhimenNathan inference/koz3_infer/experts/las.py:predict (@d434e56). The platform glue (weights loading,
+UTM.json lookup, logging) is passed in: models = [(model, kind, weight)], kind '' (9 ch), 'x' (12 ch) or 'u'.
+"""
+import os
+import time
+
+import numpy as np
+
+from . import dtm, hm, relief
+from .decode import N_HM, N_MK, decode_site_v2
+
+
+def oom_retry(fn, tiles=(1024, 512, 256), log=print):
+    """Run fn(tile) and retry with smaller tiles on CUDA out-of-memory (verbatim, koz3_infer/common.py:154)."""
+    import torch
+    for i, t in enumerate(tiles):
+        try:
+            return fn(t)
+        except torch.OutOfMemoryError:
+            torch.cuda.empty_cache()
+            log(f"CUDA OOM at tile {t}" + (f", retrying at {tiles[i + 1]}" if i + 1 < len(tiles) else ", giving up"))
+            if i + 1 == len(tiles):
+                raise
+
+
+# §7.12 (2): the 9-channel stack is a subset of the 12-channel one: relief.channels appends openness (3 ch) after
+# the 8 base channels and before valid, so x9 == x12[X9_OF_X12] bit for bit (same ops in the same order).
+X9_OF_X12 = [0, 1, 2, 3, 4, 5, 6, 7, 11]
+
+
+def _channels_extra(d, v, res, unclip=False, dev="cuda", with_valid=False):
+    """12-channel relief exactly as in training (koz3.relief with EXTRA on; UNCLIP for li_u_ models), then restored."""
+    e0, n0, u0 = relief.EXTRA, relief.N_CH, getattr(relief, "UNCLIP", False)
+    relief.EXTRA, relief.N_CH, relief.UNCLIP = True, 12, unclip
+    try:
+        out = relief.channels_tiled(d, v, res, dev=dev)
+        return out if with_valid else out[0]
+    finally:
+        relief.EXTRA, relief.N_CH, relief.UNCLIP = e0, n0, u0
+
+
+def site_probs(d, v, res, models, c, deadline, dev="cuda", log=print, acc=None):
+    """DTM → blended probability maps (N_HM + N_MK, h, w) and the valid mask at relief.NET_RES."""
+    if time.time() > deadline - 120:
+        models = models[:1]      # protect the time budget on huge clouds
+    # upstream: x9 = channels_tiled(...) first, models[:1] cut after it; the cut does not depend on x9, so moving it
+    # up only skips the 12-channel pass when the cut leaves no 'x' model (as upstream would not use it either).
+    xs = {}
+    if any(k == "x" for _, k, _ in models) and not relief.EXTRA and not getattr(relief, "UNCLIP", False):
+        x12, vv = _channels_extra(d, v, res, dev=dev, with_valid=True)
+        xs["x"] = x12
+        if any(k == "" for _, k, _ in models):
+            xs[""] = x12[X9_OF_X12]
+    else:
+        x, vv = relief.channels_tiled(d, v, res, dev=dev)
+        xs[""] = x
+        if any(k == "x" for _, k, _ in models):
+            xs["x"] = _channels_extra(d, v, res, dev=dev)
+    if any(k == "u" for _, k, _ in models):
+        xs["u"] = _channels_extra(d, v, res, unclip=True, dev=dev)
+    tta = c.get("tta", True)        # "d8": 4 rotations × 2 flips (nested OOF 0.5651 → 0.5695); True: 3 flips
+    if tta == "d8" and time.time() > deadline - 300:
+        tta = True                     # protect the time budget
+    acc = acc or ACC
+    if acc == "host":                   # upstream
+        ps = [oom_retry(lambda t, m=m, xx=xs[k]: hm.predict_tiled(m, xx, N_HM + N_MK, tile=t, overlap=min(192, t // 4), tta=tta, dev=dev), log=log)
+              for m, k, _ in models]
+        ws = np.array([w for _, _, w in models], np.float32)
+        prob = np.tensordot(ws / ws.sum(), np.stack(ps), axes=1)
+        return prob, vv
+    return _probs_dev(models, xs, tta, dev, acc, log), vv
+
+
+# §7.12 (5): "device_exact" (default) = tile blending on the model's device (no per-tile sync/D2H, no host-side
+# numpy blending), then the upstream host tensordot — bit-identical to "host"; "device" = also the ensemble sum on the
+# device (one D2H per site, no host stack): differs from tensordot by ≤ 1 ulp (bench/cpu_a_speedup/acc_*.json: max
+# |Δ| 6e-8, 0 threshold flips, 1 extra NMS-tie peak of 28861 on 022), opt-in; "host" = upstream.
+ACC = os.environ.get("LI_A_ACC", "device_exact")
+
+
+def _probs_dev(models, xs, tta, dev, acc, log):
+    import torch
+    from . import hm_acc
+    n = N_HM + N_MK
+    state = {"acc_dev": None}
+
+    def one(m, x):
+        def run(t):
+            try:
+                return hm_acc.predict_tiled(m, x, n, tile=t, overlap=min(192, t // 4), tta=tta, dev=dev, acc_dev=state["acc_dev"])
+            except torch.OutOfMemoryError:
+                if state["acc_dev"] is not None:
+                    raise
+                torch.cuda.empty_cache()             # no room for the site-sized maps on the GPU: blend on the host
+                log("CUDA OOM in device accumulation, falling back to host accumulators")
+                state["acc_dev"] = "cpu"
+                return hm_acc.predict_tiled(m, x, n, tile=t, overlap=min(192, t // 4), tta=tta, dev=dev, acc_dev="cpu")
+        return oom_retry(run, log=log)
+    if acc == "device_exact":
+        ps = [one(m, xs[k]).cpu().numpy() for m, k, _ in models]
+        ws = np.array([w for _, _, w in models], np.float32)
+        return np.tensordot(ws / ws.sum(), np.stack(ps), axes=1)
+    if acc != "device":
+        raise ValueError(f"LI_A_ACC {acc!r}")
+    return hm_acc.blend(models, xs, n, one, log=log)
+
+
+def _dtms(paths, pool):
+    """(path, (dtm, valid, origin)) in input order: sequential dtm.build (upstream) or a DtmPool (§7.12 (6))."""
+    if not pool:
+        for p in paths:
+            yield p, dtm.build(str(p))
+        return
+    from .dtm_pool import DtmPool
+    for i, _, res, _ in DtmPool(paths, **pool):
+        yield paths[i], res
+
+
+def _site(p, d, v, origin, models, c, crs, region_name, deadline, dev, log):
+    t0 = time.time()
+    x0, ytop, res = origin
+    prob, vv = site_probs(d, v, res, models, c, deadline, dev=dev, log=log)
+    meta = {"x0": x0, "ytop": ytop, "res": relief.NET_RES, "crs": crs, "region": region_name}
+    fs = decode_site_v2(prob, vv, meta, thr=c["thr"], dual=c["dual"], comp_thr=c["comp_thr"], fort_min_px=c["fort_min_px"], gor_min_px=c["gor_min_px"], r_out=c["r_out"], prior=c.get("nbr_prior"))
+    for f in fs:
+        f["properties"].update({"sub_region_name": "", "crs": "urn:ogc:def:crs:EPSG::3857"})
+    log(f"li {p.name if hasattr(p, 'name') else p}: dtm {d.shape} res {res} → {len(fs)} feats {time.time() - t0:.0f}s")
+    return fs
+
+
+def predict(paths, models, c, crs, region_name, deadline, dev="cuda", log=print, pool=None):
+    """→ GeoJSON-like features (EPSG:3857) for the LAS files of one region; c = config['li'].
+
+    pool: None → upstream sequential DTMs; dict(workers=, ram_budget=) → DTMs built in worker processes (byte-equal)."""
+    feats = []
+    paths = list(paths)
+    for p, (d, v, origin) in _dtms(paths, pool):
+        feats += _site(p, d, v, origin, models, c, crs, region_name, deadline, dev, log)
+    return feats
+
+
+def predict_all(jobs, models, c, deadline, dev="cuda", log=print, workers=2, ram_budget=1 << 30):
+    """§7.12 (6), run level: one DtmPool over the LAS files of ALL regions (jobs = [(region_name, paths, crs)]).
+
+    The consumer takes DTMs in completion order (the largest file, ~58 % of the points, starts first and the GPU works
+    on the small ones meanwhile); features are reassembled in the upstream order, so the output equals the per-region
+    sequential predict() unless a deadline guard fires at a different moment. → {region_name: features}."""
+    from .dtm_pool import DtmPool
+    flat = [(r, p, crs) for r, paths, crs in jobs for p in paths]
+    got = {}
+    for i, _, (d, v, origin), _ in DtmPool([p for _, p, _ in flat], workers=workers, ram_budget=ram_budget, ordered=False):
+        r, p, crs = flat[i]
+        got[i] = _site(p, d, v, origin, models, c, crs, r, deadline, dev, log)
+        del d, v
+    out = {r: [] for r, _, _ in jobs}
+    for i, (r, _, _) in enumerate(flat):
+        out[r] += got[i]
+    return out
