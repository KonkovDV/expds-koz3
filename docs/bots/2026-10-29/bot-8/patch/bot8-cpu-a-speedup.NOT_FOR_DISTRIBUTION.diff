new file mode 100644
index 0000000..a1b602f
--- /dev/null
+++ b/tests/test_li_a.py
@@ -0,0 +1,192 @@
+"""Scenario (a) speedups (BUDGET §7.12): each fast path must reproduce the verbatim EhimenNathan port."""
+import time
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("scipy")
+
+from expds.li_a import expert, hm, relief  # noqa: E402
+from expds.li_a.decode import N_HM, N_MK  # noqa: E402
+
+DEV = "cpu"
+
+
+def _dtm(h=900, w=700, seed=0):
+    """Smooth synthetic terrain with mounds and an invalid border/hole (0.25 m cells)."""
+    rng = np.random.default_rng(seed)
+    yy, xx = np.mgrid[0:h, 0:w].astype(np.float32)
+    z = 0.002 * xx + 0.001 * yy + np.sin(xx / 37.0) * 0.3
+    for _ in range(20):
+        cy, cx, r = rng.uniform(0, h), rng.uniform(0, w), rng.uniform(8, 30)
+        z += 1.5 * np.exp(-((yy - cy) ** 2 + (xx - cx) ** 2) / (2 * r * r))
+    z += rng.normal(0, 0.02, z.shape)
+    v = np.ones((h, w), bool)
+    v[:40] = False; v[300:380, 200:330] = False
+    return z.astype(np.float32), v
+
+
+class _Net(torch.nn.Module):
+    def __init__(self, cin, seed):
+        super().__init__()
+        g = torch.Generator().manual_seed(seed)
+        self.c = torch.nn.Conv2d(cin, N_HM + N_MK, 3, padding=1)
+        with torch.no_grad():
+            self.c.weight.copy_(torch.randn(self.c.weight.shape, generator=g) * 0.1)
+            self.c.bias.copy_(torch.randn(self.c.bias.shape, generator=g) * 0.1)
+
+    def forward(self, x):
+        return self.c(x)
+
+
+def _models():
+    return [(_Net(9, 1), "", 0.5), (_Net(9, 2), "", 0.5), (_Net(12, 3), "x", 1.0)]
+
+
+def _ref_site_probs(d, v, res, models, c, deadline):
+    """Upstream order (experts/las.py:predict @d434e56): x9 first, then a separate 12-channel pass."""
+    x, vv = relief.channels_tiled(d, v, res, dev=DEV)
+    xs = {"": x}
+    if any(k == "x" for _, k, _ in models):
+        xs["x"] = expert._channels_extra(d, v, res, dev=DEV)
+    ps = [hm.predict_tiled(m, xs[k], N_HM + N_MK, tile=256, overlap=64, tta=c["tta"], dev=DEV) for m, k, _ in models]
+    ws = np.array([w for _, _, w in models], np.float32)
+    return np.tensordot(ws / ws.sum(), np.stack(ps), axes=1), vv
+
+
+@pytest.mark.parametrize("tiled", [False, True])
+def test_x9_is_subset_of_x12(tiled, monkeypatch):
+    d, v = _dtm()
+    if tiled:      # force the windowed path (3 × 2 windows) with the same margin logic as on big sites
+        orig = relief.channels_tiled
+        monkeypatch.setattr(relief, "channels_tiled", lambda *a, **k: orig(*a, tile_px=160, margin_px=60, **k))
+    x9, v9 = relief.channels_tiled(d, v, 0.25, dev=DEV)
+    x12, v12 = expert._channels_extra(d, v, 0.25, dev=DEV, with_valid=True)
+    assert x12.shape[0] == 12 and x9.shape[0] == 9
+    assert np.array_equal(x9, x12[expert.X9_OF_X12]) and np.array_equal(v9, v12)
+    assert relief.EXTRA is False and relief.N_CH == 9           # globals restored
+
+
+def test_site_probs_equal_upstream(monkeypatch):
+    d, v = _dtm(seed=1)
+    c = {"tta": True}
+    orig = hm.predict_tiled
+    monkeypatch.setattr(hm, "predict_tiled", lambda m, x, n, tile, overlap, tta, dev: orig(m, x, n, tile=256, overlap=64, tta=tta, dev=dev))
+    p_ref, vv_ref = _ref_site_probs(d, v, 0.25, _models(), c, time.time() + 1e4)
+    p, vv = expert.site_probs(d, v, 0.25, _models(), c, time.time() + 1e4, dev=DEV, acc="host")
+    assert np.array_equal(p, p_ref) and np.array_equal(vv, vv_ref)
+
+
+@pytest.mark.parametrize("ordered,budget", [(True, 1 << 34), (False, 1)])
+def test_dtm_pool_byte_equal(tmp_path, ordered, budget):
+    from conftest import write_las
+    from expds.li_a import dtm
+    from expds.li_a.dtm_pool import DtmPool
+    paths = [write_las(tmp_path / "a.las", n=60_000, seed=1), write_las(tmp_path / "b.las", n=150_000, seed=2),
+             write_las(tmp_path / "c.las", n=40_000, seed=3, ground_class=1)]          # c: no class 2 → PMF path
+    ref = [dtm.build(str(p)) for p in paths]
+    pool = DtmPool(paths, workers=2, ram_budget=budget, ordered=ordered)     # budget=1: every job runs alone
+    seen = []
+    for i, p, (d, v, origin), st in pool:
+        seen.append(i)
+        assert p == str(paths[i]) and st["wall"] >= 0
+        assert np.array_equal(d, ref[i][0]) and d.dtype == ref[i][0].dtype
+        assert np.array_equal(v, ref[i][1]) and origin == ref[i][2]
+    assert sorted(seen) == [0, 1, 2]
+    if ordered:
+        assert seen == [0, 1, 2]
+    assert pool.order[0] == 1                      # LPT: most points first
+
+
+# ---- (3) nearest-ground fill -------------------------------------------------------------------------------------
+def _ground(h=700, w=900, seed=0):
+    """Sparse ground returns with gaps, a hole and a large empty strip (cells far from any ground)."""
+    rng = np.random.default_rng(seed)
+    yy, xx = np.mgrid[0:h, 0:w].astype(np.float32)
+    g = (0.01 * xx + np.sin(yy / 23.0)).astype(np.float32)
+    g[rng.random((h, w)) < 0.35] = np.nan
+    g[200:260, 100:180] = np.nan
+    g[:, 600:] = np.nan                     # 300 cells = 75 m of no ground
+    return g
+
+
+def test_d2_max():
+    from expds.li_a import dtm
+    for res in (0.25, 0.5, 1.0, 0.3):
+        t = dtm._d2_max(res)
+        d2 = np.arange(0, 4 * t + 10)
+        assert np.array_equal(d2 <= t, np.sqrt(d2.astype(np.float64)) * res <= dtm.FILL_M)
+
+
+@pytest.mark.parametrize("rows", [37, 10 ** 6])
+def test_fill_exact_fast_byte_equal(rows, monkeypatch):
+    from expds.li_a import dtm
+    g = _ground()
+    ref, vref = dtm.fill(g, 0.25, "exact")
+    monkeypatch.setattr(dtm, "ROW_BLOCK", rows)
+    iy_, ix_ = dtm.ndi.distance_transform_edt(~np.isfinite(g), return_distances=False, return_indices=True)
+    assert np.array_equal(dtm._gather_smooth(g, iy_, ix_, ~np.isfinite(g), rows=rows, threads=2), ref)
+    out, v = dtm.fill(g, 0.25, "exact_fast")
+    assert np.array_equal(v, vref) and out.tobytes() == ref.tobytes()
+
+
+@pytest.mark.parametrize("tile,band_m", [(64, 6.0), (128, 20.0), (4096, 20.0)])
+def test_fill_band_exact_within_band(tile, band_m):
+    from expds.li_a import dtm
+    g = _ground()
+    has = np.isfinite(g)
+    dist, (ry, rx) = dtm.ndi.distance_transform_edt(~has, return_indices=True)
+    iy_, ix_, v = dtm._band_indices(has, 0.25, band_m=band_m, tile=tile, threads=2)
+    assert np.array_equal(v, dist * 0.25 <= dtm.FILL_M)
+    near = dist * 0.25 <= band_m - 0.5      # ties at equal distance may pick another ground cell: compare values
+    assert np.array_equal(g[iy_, ix_][near], g[ry, rx][near])
+    assert has[iy_, ix_].all()              # every cell (also far ones) takes a real ground value
+
