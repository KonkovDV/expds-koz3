+        got = hm_acc.predict_tiled(m, x, N_HM + N_MK, tile=256, overlap=64, tta=tta, dev=DEV).numpy()
+    assert got.dtype == ref.dtype and got.tobytes() == ref.tobytes()
+
+
+@pytest.mark.parametrize("acc", ["device_exact", "device"])
+def test_site_probs_device_acc(acc, monkeypatch):
+    d, v = _dtm(seed=2)
+    c = {"tta": True}
+    monkeypatch.setattr(expert, "oom_retry", lambda fn, log=print: fn(256))
+    with torch.no_grad():
+        ref, vr = expert.site_probs(d, v, 0.25, _models(), c, time.time() + 1e4, dev=DEV, acc="host")
+        p, vv = expert.site_probs(d, v, 0.25, _models(), c, time.time() + 1e4, dev=DEV, acc=acc)
+    assert np.array_equal(vv, vr) and p.dtype == ref.dtype
+    if acc == "device_exact":
+        assert p.tobytes() == ref.tobytes()
+    else:                                    # running sum vs BLAS tensordot: float32 rounding only
+        assert np.abs(p - ref).max() <= 4 * np.finfo(np.float32).eps
+        for t in (0.05, 0.1, 0.3, 0.5):
+            assert ((p > t) != (ref > t)).mean() < 1e-4
