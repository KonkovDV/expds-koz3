+"""§7.12 (5) (bot-8): hm.predict_tiled with the tile blending and the ensemble blend kept on the model's device.
+
+Upstream (hm.predict_tiled) copies every tile's averaged TTA output to the host (`.cpu().numpy()`, a sync per tile)
+and blends it into numpy out/cnt on one CPU thread; site_probs then stacks all models' maps on the host and blends them
+with np.tensordot. Here out/cnt live on `acc_dev` (default: the model's device) and models are summed into one device
+accumulator, so the host sees a single (N, h, w) map per site and the CPU is free for the DTM pool.
+
+Equality: the tile blending does the same IEEE float32 ops in the same order (o·wgt, then +=; cnt += wgt; out /
+max(cnt, 1e-6)), wgt is built by the same numpy code → bit-identical to hm.predict_tiled (checked on CPU torch; CUDA
+elementwise mul/add/div are IEEE-exact too, so the same holds on GPU up to the model's own output). The ensemble
+blend is a running Σ (w_i/Σw)·p_i instead of tensordot's BLAS sum: equal up to float32 rounding (≤ a few ulp, see
+tests and bench/cpu_a_speedup/acc_*.json); expert ACC "device_exact" keeps the upstream tensordot bit for bit.
+"""
+import numpy as np
+import torch
+
+_W = {}
+
+
+def _wgt(h, w, overlap, tile, first_y, last_y, first_x, last_x, inner_y, inner_x):
+    """Blend weights exactly as hm.predict_tiled (numpy float64 ramps → float32 outer product)."""
+    ramp = np.minimum(np.arange(tile) + 1, overlap) / overlap
+    wy = np.minimum(ramp[:h], ramp[:h][::-1]) if inner_y else np.ones(h)
+    wx = np.minimum(ramp[:w], ramp[:w][::-1]) if inner_x else np.ones(w)
+    if first_y: wy[:overlap] = 1
+    if last_y: wy[-overlap:] = 1
+    if first_x: wx[:overlap] = 1
+    if last_x: wx[-overlap:] = 1
+    return np.outer(wy, wx).astype(np.float32)
+
+
+def _wgt_dev(key, dev):
+    k = key + (str(dev),)
+    t = _W.get(k)
+    if t is None:
+        if len(_W) > 64:
+            _W.clear()
+        t = _W[k] = torch.from_numpy(_wgt(*key)).to(dev)
+    return t
+
+
+def predict_tiled(model, img, n_out, tile=1024, overlap=192, tta=True, dev="cuda", acc_dev=None):
+    """= hm.predict_tiled, but returns a torch tensor (n_out, H, W) on acc_dev (default dev)."""
+    acc_dev = torch.device(acc_dev or dev)
+    C, H, W = img.shape
+    out = torch.zeros((n_out, H, W), dtype=torch.float32, device=acc_dev)
+    cnt = torch.zeros((H, W), dtype=torch.float32, device=acc_dev)
+    step = tile - overlap
+    for y in list(range(0, max(1, H - overlap), step)):
+        for x in list(range(0, max(1, W - overlap), step)):
+            y1, x1 = min(H, y + tile), min(W, x + tile)
+            t = img[:, y:y1, x:x1]
+            h, w = t.shape[1:]
+            ph, pw = (-h) % 32, (-w) % 32
+            tt = torch.from_numpy(np.pad(t, ((0, 0), (0, ph), (0, pw)), mode="reflect" if min(h, w) > max(ph, pw) else "constant")).float()[None].to(dev)
+            acc = 0
+            if tta == "d8" and tt.shape[-1] == tt.shape[-2]:
+                views = [(k, fl) for k in range(4) for fl in (False, True)]
+            else:
+                views = [(0, ()), (0, (-1,)), (0, (-2,))] if tta else [(0, ())]
+            for k, fl in views:
+                z = torch.rot90(tt, k, dims=(-2, -1)) if k else tt
+                if fl is True:
+                    z = z.flip(-1)
+                elif fl:
+                    z = z.flip(fl)
+                with torch.autocast("cuda", dtype=torch.bfloat16):
+                    o = torch.sigmoid(model(z).float())
+                if fl is True:
+                    o = o.flip(-1)
+                elif fl:
+                    o = o.flip(fl)
+                acc = acc + (torch.rot90(o, -k, dims=(-2, -1)) if k else o)
+            o = (acc / len(views))[0, :, :h, :w].to(acc_dev)
+            wgt = _wgt_dev((h, w, overlap, tile, y == 0, y1 == H, x == 0, x1 == W, y > 0 or y1 < H, x > 0 or x1 < W), acc_dev)
+            out[:, y:y1, x:x1] += o * wgt
+            cnt[y:y1, x:x1] += wgt
+    return out / torch.clamp_min(cnt, 1e-6)
+
+
+def blend(models, xs, n_out, predict, log=print):
+    """Σ_i (w_i/Σw)·p_i over models = [(model, kind, weight)] on the accumulation device → numpy (n_out, H, W).
+
+    predict(model, x) → torch (n_out, H, W). Weights are normalised in float32 numpy exactly as upstream."""
+    ws = np.array([w for _, _, w in models], np.float32)
+    ws = ws / ws.sum()
+    tot = None
+    for (m, k, _), wi in zip(models, ws):
+        p = predict(m, xs[k])
+        p.mul_(float(wi))                       # float32(wi) is exact in a python float
+        if tot is None:
+            tot = p
+        else:
+            tot += p
+        del p
+    return tot.cpu().numpy()
