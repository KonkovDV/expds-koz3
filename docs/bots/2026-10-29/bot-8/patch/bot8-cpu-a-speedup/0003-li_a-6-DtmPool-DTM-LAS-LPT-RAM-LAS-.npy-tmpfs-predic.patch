+def predict(paths, models, c, crs, region_name, deadline, dev="cuda", log=print, pool=None):
+    """→ GeoJSON-like features (EPSG:3857) for the LAS files of one region; c = config['li'].
+
+    pool: None → upstream sequential DTMs; dict(workers=, ram_budget=) → DTMs built in worker processes (byte-equal)."""
     feats = []
-    for p in paths:
-        t0 = time.time()
-        d, v, (x0, ytop, res) = dtm.build(str(p))
-        prob, vv = site_probs(d, v, res, models, c, deadline, dev=dev, log=log)
-        meta = {"x0": x0, "ytop": ytop, "res": relief.NET_RES, "crs": crs, "region": region_name}
-        fs = decode_site_v2(prob, vv, meta, thr=c["thr"], dual=c["dual"], comp_thr=c["comp_thr"], fort_min_px=c["fort_min_px"], gor_min_px=c["gor_min_px"], r_out=c["r_out"], prior=c.get("nbr_prior"))
-        for f in fs:
-            f["properties"].update({"sub_region_name": "", "crs": "urn:ogc:def:crs:EPSG::3857"})
-        feats += fs
-        log(f"li {p.name if hasattr(p, 'name') else p}: dtm {d.shape} res {res} → {len(fs)} feats {time.time() - t0:.0f}s")
+    paths = list(paths)
+    for p, (d, v, origin) in _dtms(paths, pool):
+        feats += _site(p, d, v, origin, models, c, crs, region_name, deadline, dev, log)
     return feats
+
+
+def predict_all(jobs, models, c, deadline, dev="cuda", log=print, workers=2, ram_budget=1 << 30):
+    """§7.12 (6), run level: one DtmPool over the LAS files of ALL regions (jobs = [(region_name, paths, crs)]).
+
+    The consumer takes DTMs in completion order (the largest file, ~58 % of the points, starts first and the GPU works
+    on the small ones meanwhile); features are reassembled in the upstream order, so the output equals the per-region
+    sequential predict() unless a deadline guard fires at a different moment. → {region_name: features}."""
+    from .dtm_pool import DtmPool
+    flat = [(r, p, crs) for r, paths, crs in jobs for p in paths]
+    got = {}
+    for i, _, (d, v, origin), _ in DtmPool([p for _, p, _ in flat], workers=workers, ram_budget=ram_budget, ordered=False):
+        r, p, crs = flat[i]
+        got[i] = _site(p, d, v, origin, models, c, crs, r, deadline, dev, log)
+        del d, v
+    out = {r: [] for r, _, _ in jobs}
+    for i, (r, _, _) in enumerate(flat):
+        out[r] += got[i]
+    return out
