+        yy, xx = np.mgrid[y0:y1, x0:x1]
+        fy, fx = float((w * yy).sum() / w.sum()), float((w * xx).sum() / w.sum())
+        X = T.c + (fx + 0.5) * T.a + (fy + 0.5) * T.b
+        Y = T.f + (fx + 0.5) * T.d + (fy + 0.5) * T.e
