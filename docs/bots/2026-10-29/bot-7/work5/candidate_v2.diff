+                        out += finds_candidates(Pm["finds"], d, reg.name, mt, f.name)
+                    r = PHASE["rate"].setdefault((mt, mode), [0.0, 0.0])
+                    r[0] += time.perf_counter() - t0; r[1] += max(mpxv, 1e-6)
