+def _cs():
+    spec = importlib.util.spec_from_file_location("b6_cs", ROOT / "scripts" / "check_submission.py")
+    cs = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(cs)
+    cs.RESULTS.clear()
+    return cs
