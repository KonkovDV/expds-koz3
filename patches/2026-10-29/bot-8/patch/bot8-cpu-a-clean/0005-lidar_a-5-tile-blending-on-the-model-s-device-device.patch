@@ -90,6 +90,42 @@ def infer_map(model, stack, n_out, tile=1024, overlap=192, tta=True, dev="cuda")
     return acc / np.maximum(norm, 1e-6)
 
 
+_WEIGHT_CACHE = {}
+
+
+def _device_weights(ys, xs, shape, tile, overlap, dev):
+    """tile_weights as a device tensor, cached by the tile's weight pattern (built on the host: identical values)."""
+    (y0, y1), (x0, x1) = ys, xs
+    key = (y1 - y0, x1 - x0, y0 == 0, y1 == shape[0], y0 > 0 or y1 < shape[0],
+           x0 == 0, x1 == shape[1], x0 > 0 or x1 < shape[1], tile, overlap, str(dev))
+    hit = _WEIGHT_CACHE.get(key)
+    if hit is None:
+        if len(_WEIGHT_CACHE) > 64:
+            _WEIGHT_CACHE.clear()
+        hit = _WEIGHT_CACHE[key] = torch.from_numpy(tile_weights(ys, xs, shape, tile, overlap)).to(dev)
+    return hit
+
+
+@torch.no_grad()
+def infer_map_on_device(model, stack, n_out, tile=1024, overlap=192, tta=True, dev="cuda", acc_dev=None):
+    """Item (5): infer_map with the blend buffers on acc_dev (default: the model's device) → torch (n_out, H, W).
+
+    Same float32 operations in the same order as infer_map (pred·w, then +=; norm += w; acc / max(norm, 1e-6)), so the
+    result is bit-equal; no per-tile device→host copy or host-side blending."""
+    acc_dev = torch.device(acc_dev or dev)
+    _, H, W = stack.shape
+    acc = torch.zeros((n_out, H, W), dtype=torch.float32, device=acc_dev)
+    norm = torch.zeros((H, W), dtype=torch.float32, device=acc_dev)
+    for ys, xs in tile_grid(H, W, tile, overlap):
+        (y0, y1), (x0, x1) = ys, xs
+        batch = torch.from_numpy(_pad_tile(stack[:, y0:y1, x0:x1])).float()[None].to(dev)
+        pred = tta_mean(model, batch, tta)[0, :, :y1 - y0, :x1 - x0].to(acc_dev)
+        wt = _device_weights(ys, xs, (H, W), tile, overlap, acc_dev)
+        acc[:, y0:y1, x0:x1] += pred * wt
+        norm[y0:y1, x0:x1] += wt
+    return acc / torch.clamp_min(norm, 1e-6)
+
+
 def with_oom_ladder(run, tiles=OOM_TILES, log=print):
     """run(tile) with smaller tiles after CUDA out-of-memory."""
     for i, t in enumerate(tiles):
diff --git a/tests/test_lidar_a.py b/tests/test_lidar_a.py
index caa7cef..952d27f 100644
--- a/tests/test_lidar_a.py
+++ b/tests/test_lidar_a.py
@@ -126,3 +126,39 @@ def test_band_fill_keeps_network_input(monkeypatch):
     p0 = tiling.infer_map(net, x0, 3, tile=256, overlap=64, tta=False, dev="cpu")
     p1 = tiling.infer_map(net, x1, 3, tile=256, overlap=64, tta=False, dev="cpu")
     assert np.array_equal(p0, p1)
+
+
+# ---- (5) blending on the model's device ------------------------------------------------------------------------------
+class _Net(torch.nn.Module):
+    def __init__(self, cin, cout, seed=0):
+        super().__init__()
+        g = torch.Generator().manual_seed(seed)
+        self.a = torch.nn.Conv2d(cin, 6, 3, padding=1); self.b = torch.nn.Conv2d(6, cout, 3, padding=1)
+        for p in self.parameters():
+            p.data = torch.randn(p.shape, generator=g) * 0.3
+
+    def forward(self, x):
+        return self.b(torch.relu(self.a(x)))
+
+
+@pytest.mark.filterwarnings("ignore::UserWarning")
+@pytest.mark.parametrize("tta,shape", [(True, (9, 450, 350)), (False, (9, 300, 700)), ("d8", (9, 512, 512)), (True, (9, 100, 90))])
+def test_device_blend_bitwise(tta, shape):
+    from expds.lidar_a import tiling
+    x = np.random.default_rng(3).normal(size=shape).astype(np.float32)
+    net = _Net(9, 3).eval()
+    ref = tiling.infer_map(net, x, 3, tile=256, overlap=64, tta=tta, dev="cpu")
+    got = tiling.infer_map_on_device(net, x, 3, tile=256, overlap=64, tta=tta, dev="cpu").numpy()
+    assert got.tobytes() == ref.tobytes()
+
+
+@pytest.mark.filterwarnings("ignore::UserWarning")
+def test_site_maps_accumulation_modes():
+    from expds.lidar_a import runner
+    d, v = _dtm(5, (300, 260))
+    models = [(_Net(9, 3, 1).eval(), "", 0.5), (_Net(9, 3, 2).eval(), "", 0.5), (_Net(12, 3, 3).eval(), "x", 1.0)]
+    host, vh = runner.site_maps(d, v, 0.25, models, 3, tta=True, dev="cpu", accumulate="host")
+    exact, ve = runner.site_maps(d, v, 0.25, models, 3, tta=True, dev="cpu", accumulate="device_exact")
+    dev_, vd = runner.site_maps(d, v, 0.25, models, 3, tta=True, dev="cpu", accumulate="device")
+    assert exact.tobytes() == host.tobytes() and (vh == ve).all() and (vh == vd).all()
+    assert np.abs(dev_ - host).max() <= 4 * np.spacing(np.float32(1))
