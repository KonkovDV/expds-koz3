From 13bcf612430499ec514c19a6b92800adbcf199e2 Mon Sep 17 00:00:00 2001
From: bot-8 <bot-8@local>
Date: Wed, 28 Oct 2026 23:17:43 +0300
Subject: [PATCH 2/6] lidar_a (2): 9-channel stack sliced from the 12-channel
 one when both are used (bit-equal)

---
 expds/lidar_a/runner.py | 14 +++++++++++---
 tests/test_lidar_a.py   | 30 ++++++++++++++++++++++++++++++
 2 files changed, 41 insertions(+), 3 deletions(-)
 create mode 100644 tests/test_lidar_a.py

diff --git a/expds/lidar_a/runner.py b/expds/lidar_a/runner.py
index 7ee9cca..7f103d2 100644
--- a/expds/lidar_a/runner.py
+++ b/expds/lidar_a/runner.py
@@ -24,10 +24,18 @@ def guard_tta(tta, deadline):
     return True if tta == "d8" and time.time() > deadline - FLIPS_ONLY_LEFT_S else tta
 
 
-def stacks_for(dtm, valid, cell, kinds, dev):
-    """{kind: stack} for the kinds in use and the valid mask at NET_CELL."""
+def stacks_for(dtm, valid, cell, kinds, dev, share=True):
+    """{kind: stack} for the kinds in use and the valid mask at NET_CELL.
+
+    share (item (2)): the 9-channel stack is planes terrain.BASE_OF_EXTRA of the 12-channel one (same operations in
+    the same order), so with both '' and 'x' in use the 12-channel stack is computed once and sliced."""
     got, vmask = {}, None
-    for kind in kinds:
+    todo = list(kinds)
+    if share and "" in todo and "x" in todo:
+        got["x"], vmask = terrain.relief_stack_windowed(dtm, valid, cell, dev=dev, **KIND_ARGS["x"])
+        got[""] = got["x"][terrain.BASE_OF_EXTRA]
+        todo = [k for k in todo if k not in ("", "x")]
+    for kind in todo:
         got[kind], vk = terrain.relief_stack_windowed(dtm, valid, cell, dev=dev, **KIND_ARGS[kind])
         vmask = vk if vmask is None else vmask
     return got, vmask
diff --git a/tests/test_lidar_a.py b/tests/test_lidar_a.py
new file mode 100644
index 0000000..b1d7040
--- /dev/null
+++ b/tests/test_lidar_a.py
@@ -0,0 +1,30 @@
+"""expds.lidar_a: own invariants of the speedups (no reference copy needed)."""
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+
+
+def _dtm(seed=0, shape=(203, 157)):
+    rng = np.random.default_rng(seed)
+    yy, xx = np.mgrid[:shape[0], :shape[1]].astype(np.float32)
+    d = (100 + 0.05 * xx + 0.02 * yy + 1.5 * np.exp(-((xx - 70) ** 2 + (yy - 90) ** 2) / 300)).astype(np.float32)
+    d += rng.normal(0, 0.05, shape).astype(np.float32)
+    v = np.ones(shape, bool); v[:20, :30] = False; v[150:, 100:] = False
+    return d, v
+
+
+@pytest.mark.parametrize("window", [None, 64])
+def test_base_stack_is_slice_of_extra(window):
+    from expds.lidar_a import runner, terrain
+    d, v = _dtm(1, (330, 290))
+    kw = {} if window is None else dict(window=window, margin=24)
+    x9, v9 = terrain.relief_stack_windowed(d, v, 0.25, extra=False, dev="cpu", **kw)
+    x12, v12 = terrain.relief_stack_windowed(d, v, 0.25, extra=True, dev="cpu", **kw)
+    assert x12[terrain.BASE_OF_EXTRA].tobytes() == x9.tobytes() and (v9 == v12).all()
+    if window is not None:
+        return
+    got, gv = runner.stacks_for(d, v, 0.25, ["", "x"], "cpu")
+    assert got[""].tobytes() == x9.tobytes() and got["x"].tobytes() == x12.tobytes() and (gv == v9).all()
