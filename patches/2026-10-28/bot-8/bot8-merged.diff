+def collect_both(fc, is_gt):
+    m = mod()
+    calc = m.F1Calculator()
+    metric._UTM_GEOM_CACHE.clear()
+    new = metric._collect(m, calc, fc, is_gt)
+    metric._UTM_GEOM_CACHE.clear()
+    ref = metric._collect_reference(m, calc, fc, is_gt)
+    return new, ref
