+        ang = np.sort(rng.uniform(0, 2 * np.pi, n)) if i % 3 else rng.uniform(0, 2 * np.pi, n)
+        pts = np.c_[X0 + r * np.cos(ang), Y0 + r * np.sin(ang)].tolist()
