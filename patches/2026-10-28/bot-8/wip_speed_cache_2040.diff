+/// Есть ли в байтах `n` и более ASCII-цифр подряд (проверка перед orjson: длинное целое
+/// orjson превратил бы во float, а json — в int; тогда scoreboard читает стандартным json).
+#[pyfunction]
+fn has_digit_run(data: &[u8], n: usize) -> bool {
+    if n == 0 {
+        return true;
+    }
+    let mut run = 0usize;
+    for &b in data {
+        if b.is_ascii_digit() {
+            run += 1;
+            if run >= n {
+                return true;
+            }
+        } else {
+            run = 0;
+        }
+    }
+    false
+}
