+def test_default_scope_is_global(monkeypatch):
+    monkeypatch.delenv("EXPDS_MATCH_SCOPE", raising=False)
+    assert M.match_scope() == "global"
+    assert M.match_scope(None) == "global"
+    monkeypatch.setenv("EXPDS_MATCH_SCOPE", "")
