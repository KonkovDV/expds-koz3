     cpu::init();
@@ -330,5 +348,6 @@ fn expds_core(m: &Bound<'_, PyModule>) -> PyResult<()> {
     m.add_function(wrap_pyfunction!(relief_channels, m)?)?;
     m.add_function(wrap_pyfunction!(sample_window_max, m)?)?;
     m.add_function(wrap_pyfunction!(ring_stats, m)?)?;
