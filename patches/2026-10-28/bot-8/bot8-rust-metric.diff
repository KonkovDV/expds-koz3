+def test_build_curves_empty_sides():
+    empty = {"type": "FeatureCollection", "features": []}
+    pred, gt = synth_fc(7, 200), synth_fc(8, 100, gt=True)
+    for p, g in ((empty, gt), (pred, empty), (empty, empty)):
+        assert_curves_equal(*build_both(p, g))
