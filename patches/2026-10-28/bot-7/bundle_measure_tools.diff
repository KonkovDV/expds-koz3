+
+
+def r3(o):
+    if isinstance(o, (list, tuple)):
+        return [r3(x) for x in o]
+    return round(float(o), 3)
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--fam", required=True)
+    ap.add_argument("--out", required=True)
